msgid "Voltar"
msgstr "돌아가려면"

#: usr/local/bin/chili-clonedisk:2444
msgid "DISCO DE ORIGEM"
msgstr "소스 디스크"

#: usr/local/bin/chili-clonedisk:2445
msgid "PARTIÇÃO DE ORIGEM"
msgstr "소스 파티션"

#: usr/local/bin/chili-clonedisk:2446
msgid "PARTIÇÃO DE DESTINO"
msgstr "대상 파티션"

#: usr/local/bin/chili-clonedisk:2447
msgid "AVISO!"
msgstr "알아채다!"

#: usr/local/bin/chili-clonedisk:2447
msgid "Todos os dados disco/partição de DESTINO abaixo serão perdidos!"
msgstr "아래의 모든 DESTINATION 디스크/파티션 데이터가 손실됩니다!"

#: usr/local/bin/chili-clonedisk:2448
msgid "Continuar com a clonagem"
msgstr "복제 계속하기"

#: usr/local/bin/chili-clonedisk:2449
msgid "IMAGEM ORIGEM"
msgstr "소스 이미지"

