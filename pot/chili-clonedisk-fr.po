msgstr "Vérifiez les autorisations d'écriture de l'utilisateur sur la destination."

#: usr/local/bin/chili-clonedisk:2531
msgid "CLONAGEM REMOTA EM ANDAMENTO"
msgstr "CLONAGE À DISTANCE EN COURS"

#: usr/local/bin/chili-clonedisk:2532
msgid "Processando: pv -> conversor/compressor -> SSH -> Rede"
msgstr "Traitement : pv -> convertisseur/compresseur -> SSH -> Réseau"

#: usr/local/bin/chili-clonedisk:2533
msgid "DESTINO REMOTO :"
msgstr "DESTINATION À DISTANCE :"

#: usr/local/bin/chili-clonedisk:2534
msgid "Resumo da Operação de Rede"
msgstr "Résumé du fonctionnement du réseau"

#: usr/local/bin/chili-clonedisk:2535
msgid "Clonagem Remota Concluída com Sucesso!"
msgstr "Clonage à distance terminé avec succès !"

#: usr/local/bin/chili-clonedisk:2536
