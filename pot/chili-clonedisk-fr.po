msgid "MENU PRINCIPAL"
msgstr "Principe du menu"

#: usr/local/bin/chili-clonedisk:2541
msgid "Partição local -> Imagem remota"
msgstr "Partition locale -> Image distante"

#: usr/local/bin/chili-clonedisk:2542
