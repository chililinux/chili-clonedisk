msgstr "Partition locale -> Partition distante"

#: usr/local/bin/chili-clonedisk:2544
msgid "clonar partição local para partição remota"
msgstr "cloner une partition locale sur une partition distante"

#: usr/local/bin/chili-clonedisk:2545
msgid "Partição remota -> Imagem local"
msgstr "Partition distante -> Image locale"

#: usr/local/bin/chili-clonedisk:2546
msgid "clonar partição remota para imagem local"
msgstr "cloner une partition distante sur une image locale"

#: usr/local/bin/chili-clonedisk:2547
msgid "Partição remota -> Partição local"
msgstr "Partition distante -> Partition locale"

#: usr/local/bin/chili-clonedisk:2548
msgid "clonar partição remota para partição local"
msgstr "cloner une partition distante sur une partition locale"

#: usr/local/bin/chili-clonedisk:2549
msgid "Partição remota"
msgstr "Partition distante"

#: usr/local/bin/chili-clonedisk:2550
msgid "Verificação de integridade"
msgstr "Contrôle d'intégrité"

#: usr/local/bin/chili-clonedisk:2551
msgid "Calculando sha256..."
msgstr "Calcul de sha256..."

#: usr/local/bin/chili-clonedisk:2552
msgid "Testando o checksum embutido no formato..."
msgstr "Test de la somme de contrôle intégrée au format..."

#: usr/local/bin/chili-clonedisk:2553
msgid "Relendo o destino para comparar..."
msgstr "Relire le destin pour comparer..."

#: usr/local/bin/chili-clonedisk:2554
#, sh-printf-format
msgid "A imagem %s está corrompida ou foi alterada. Não é seguro gravá-la."
msgstr "L'image %s est corrompue ou modifiée. Il n'est pas prudent de l'enregistrer."

#: usr/local/bin/chili-clonedisk:2555
msgid "esperado"
msgstr "attendu"

#: usr/local/bin/chili-clonedisk:2556
msgid "obtido"
msgstr "obtenu"

#: usr/local/bin/chili-clonedisk:2557
#, sh-printf-format
msgid "A imagem %s não tem hash guardado (.sha256/.info)."
msgstr "L'image %s n'a pas de hachage enregistré (.sha256/.info)."

#: usr/local/bin/chili-clonedisk:2558
msgid ""
"Verificado só o checksum embutido no formato: detecta corrupção, mas não uma "
"troca da imagem."
msgstr "Seule la somme de contrôle intégrée au format a été vérifiée : elle détecte une corruption, mais pas un changement d'image."

#: usr/local/bin/chili-clonedisk:2559
msgid ""
"Verificada só a estrutura do qcow2 (qemu-img check); os dados não puderam "
"ser conferidos."
msgstr "Seule la structure qcow2 a été vérifiée (qemu-img check) ; les données n'ont pas pu être vérifiées."

#: usr/local/bin/chili-clonedisk:2560
msgid "Imagem raw sem hash: não há como verificar se ela está íntegra."
msgstr "Image brute sans hachage : il n'y a aucun moyen de vérifier si elle est intacte."

#: usr/local/bin/chili-clonedisk:2561
msgid ""
"Gerar o .sha256 agora? Ele não prova que a imagem está intacta desde a "
"criação, mas serve de referência daqui para frente."
msgstr "Générer le .sha256 maintenant ? Cela ne prouve pas que l’image soit intacte depuis sa création, mais elle sert de référence pour l’avenir."

#: usr/local/bin/chili-clonedisk:2562
msgid ""
"Verificar a integridade da imagem antes de gravar? (lê a imagem inteira)"
msgstr "Vérifier l'intégrité de l'image avant l'enregistrement ? (lire l'image entière)"

