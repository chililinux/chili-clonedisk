msgstr "Vérifier l'enregistrement ? Relis %s (%s) et le compare avec ce qui a été enregistré."

#: usr/local/bin/chili-clonedisk:2564
#, sh-printf-format
msgid "Gravação verificada: %s confere com o que foi gravado."
msgstr "Enregistrement vérifié : %s correspond à ce qui a été enregistré."

