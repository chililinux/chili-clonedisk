msgid "IMAGEM DESTINO"
msgstr "ИЗОБРАЖЕНИЕ НАЗНАЧЕНИЯ"

#: usr/local/bin/chili-clonedisk:2451
msgid "Clonagem concluída!"
msgstr "Клонирование завершено!"

