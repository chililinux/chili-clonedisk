msgid "TESTANDO SENHA"
msgstr "ПРОВЕРКА ПАРОЛЯ"

#: usr/local/bin/chili-clonedisk:2525
msgid "Validando senha no servidor remoto..."
msgstr "Проверка пароля на удаленном сервере..."

#: usr/local/bin/chili-clonedisk:2526
msgid "ERRO DE AUTENTICAÇÃO"
msgstr "ОШИБКА АУТЕНТИФИКАЦИИ"

#: usr/local/bin/chili-clonedisk:2527
msgid "Senha incorreta ou acesso rejeitado pelo servidor remoto!"
msgstr "Неправильный пароль или доступ отклонен удаленным сервером!"

#: usr/local/bin/chili-clonedisk:2528
msgid "Verifique suas credenciais e tente novamente."
msgstr "Пожалуйста, проверьте свои учетные данные и повторите попытку."

#: usr/local/bin/chili-clonedisk:2529
msgid "FORMATO DE COMPRESSÃO"
msgstr "ФОРМАТ СЖАТИЯ"

#: usr/local/bin/chili-clonedisk:2530
msgid "Escolha o formato de saída para a imagem remota:"
msgstr "Выберите выходной формат удаленного изображения:"

#: usr/local/bin/chili-clonedisk:2531
msgid "Otimizado/Adaptativo"
msgstr "Оптимизированный/Адаптивный"

#: usr/local/bin/chili-clonedisk:2532
msgid "Compatibilidade"
msgstr "Совместимость"

#: usr/local/bin/chili-clonedisk:2533
msgid "Máxima Compressão"
msgstr "Максимальное сжатие"

#: usr/local/bin/chili-clonedisk:2534
msgid "Sem compressão (Imagem Raw / bruto)"
msgstr "Без сжатия (изображение в формате Raw)"

#: usr/local/bin/chili-clonedisk:2535
msgid "SERVIDOR DESTINO :"
msgstr "НАЗНАЧИТЕЛЬНЫЙ СЕРВЕР:"

#: usr/local/bin/chili-clonedisk:2536
msgid "ARQUIVO REMOTO   :"
msgstr "УДАЛЕННЫЙ ФАЙЛ:"

#: usr/local/bin/chili-clonedisk:2537
msgid "Confirmar o início da clonagem criptografada via rede?"
msgstr "Подтвердить начало зашифрованного клонирования по сети?"

#: usr/local/bin/chili-clonedisk:2538
msgid "Iniciando transmissão de"
msgstr "Начало передачи"

#: usr/local/bin/chili-clonedisk:2539
msgid "PREPARANDO DESTINO"
msgstr "ПОДГОТОВКА НАЗНАЧЕНИЯ"

#: usr/local/bin/chili-clonedisk:2540
msgid "Garantindo que o diretório remoto existe..."
msgstr "Обеспечение существования удаленного каталога..."

#: usr/local/bin/chili-clonedisk:2541
msgid "ERRO DE DIRETÓRIO"
msgstr "ОШИБКА СПРАВОЧНИКА"

#: usr/local/bin/chili-clonedisk:2542
msgid "Falha ao criar o diretório remoto:"
msgstr "Не удалось создать удаленный каталог:"

#: usr/local/bin/chili-clonedisk:2543
msgid "Verifique as permissões de escrita do usuário no destino."
msgstr "Проверьте права пользователя на запись в месте назначения."

#: usr/local/bin/chili-clonedisk:2544
msgid "CLONAGEM REMOTA EM ANDAMENTO"
msgstr "ВЫПОЛНЯЕТСЯ УДАЛЕННОЕ КЛОНИРОВАНИЕ"

#: usr/local/bin/chili-clonedisk:2545
msgid "Processando: pv -> conversor/compressor -> SSH -> Rede"
msgstr "Обработка: pv -> конвертер/компрессор -> SSH -> Сеть"

#: usr/local/bin/chili-clonedisk:2546
msgid "DESTINO REMOTO :"
msgstr "УДАЛЕННОЕ НАПРАВЛЕНИЕ:"

#: usr/local/bin/chili-clonedisk:2547
msgid "Resumo da Operação de Rede"
msgstr "Сводная информация о работе сети"

#: usr/local/bin/chili-clonedisk:2548
msgid "Clonagem Remota Concluída com Sucesso!"
msgstr "Удаленное клонирование успешно завершено!"

#: usr/local/bin/chili-clonedisk:2549
msgid "Origem Local     :"
msgstr "Местное происхождение:"

#: usr/local/bin/chili-clonedisk:2550
msgid "Destino Remoto   :"
msgstr "Удаленный пункт назначения:"

#: usr/local/bin/chili-clonedisk:2551
msgid "Tamanho Remoto   :"
msgstr "Удаленный Размер:"

#: usr/local/bin/chili-clonedisk:2552
msgid "SELECIONE O DISCO DE ORIGEM PARA REDE"
msgstr "ВЫБЕРИТЕ ИСХОДНЫЙ ДИСК ДЛЯ СЕТИ"

#: usr/local/bin/chili-clonedisk:2553
msgid "MENU PRINCIPAL"
msgstr "Главное меню"

#: usr/local/bin/chili-clonedisk:2554
#, sh-printf-format
msgid ""
"O computador remoto %s não tem as ferramentas necessárias para esta operação."
msgstr "Удаленный компьютер %s не имеет необходимых инструментов для этой операции."

#: usr/local/bin/chili-clonedisk:2555
#, sh-printf-format
