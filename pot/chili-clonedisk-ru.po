msgid "TESTANDO CONEXÃO"
msgstr "ТЕСТИРОВАНИЕ СОЕДИНЕНИЯ"

#: usr/local/bin/chili-clonedisk:2518
msgid "Tentando conexão via Chave Pública em"
msgstr "Попытка подключения через открытый ключ"

