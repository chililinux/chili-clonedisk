msgid "Entre com as credenciais do servidor SSH de destino e caminho:"
msgstr "Введите учетные данные и путь целевого SSH-сервера:"

#: usr/local/bin/chili-clonedisk:2511
msgid "Usuário Remoto  :"
msgstr "Удаленный пользователь:"

#: usr/local/bin/chili-clonedisk:2512
msgid "IP do Servidor  :"
msgstr "IP-адрес сервера:"

#: usr/local/bin/chili-clonedisk:2513
msgid "Porta SSH       :"
msgstr "SSH-порт:"

#: usr/local/bin/chili-clonedisk:2514
msgid "Arquivo Destino :"
msgstr "Целевой файл:"

#: usr/local/bin/chili-clonedisk:2515
msgid "CONFIGURAÇÃO SSH"
msgstr "КОНФИГУРАЦИЯ SSH"

#: usr/local/bin/chili-clonedisk:2516
msgid "Todos os campos devem ser preenchidos! Tente novamente."
msgstr "Все поля должны быть заполнены! Пожалуйста, попробуйте еще раз."

