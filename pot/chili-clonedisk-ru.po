msgstr "Этикетка"

#: usr/local/bin/chili-clonedisk:2464
msgid "Modelo"
msgstr "Модель"

#: usr/local/bin/chili-clonedisk:2465
msgid "Tamanho"
msgstr "Размер"

#: usr/local/bin/chili-clonedisk:2466
msgid "Sistema de arquivos"
msgstr "Файловая система"

#: usr/local/bin/chili-clonedisk:2467
msgid "Entre com o nome da imagem"
msgstr "Введите название изображения"

#: usr/local/bin/chili-clonedisk:2468
msgid "NOME DA IMAGEM"
msgstr "НАЗВАНИЕ ИЗОБРАЖЕНИЯ"

#: usr/local/bin/chili-clonedisk:2469
msgid "Nome da imagem inválido! Tente novamente."
msgstr "Неверное название изображения! Пожалуйста, попробуйте еще раз."

#: usr/local/bin/chili-clonedisk:2470
#, sh-printf-format
msgid "Imagem '%s' já existe. Tentar outro nome?"
msgstr "Изображение «%s» уже существует. Попробовать другое имя?"

