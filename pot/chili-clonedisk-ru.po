msgid "binário não foi localizado na pasta local:"
msgstr "двоичный файл не найден в локальной папке:"

#: usr/local/bin/chili-clonedisk:2509
msgid "DICA: instale o pacote chili-utils"
msgstr "СОВЕТ: установите пакет chili-utils"

