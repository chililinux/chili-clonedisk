	local xtitle="$1"
	shift
	${DIALOG} \
		--title "$xtitle" \
		--backtitle "$ccabec" \
		--colors \
		--beep \
		--no-cr-wrap \
		--no-collapse \
		--msgbox "$*" \
		25 100 >/dev/tty
}

