	cmsg_desc_iso="$(gettext "gravar ISO para dar boot")"
	cmsg_dir_rede_envia="$(gettext "Disco local -> Imagem remota")"
	cmsg_desc_rede_envia="$(gettext "clonar disco local para imagem remota")"
