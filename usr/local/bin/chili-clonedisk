}

#figlet
sh_logo() {
	printf '%s' "$green"
	cat <<'EOF'
      _                      _ _     _
  ___| | ___  _ __   ___  __| (_)___| | __   Copyright (c) 2019-2026 Vilmar Catafesta <vcatafesta@gmail.com>
 / __| |/ _ \| '_ \ / _ \/ _` | / __| |/ /   Copyright (c) 2019-2026 ChiliLinux Development Team
| (__| | (_) | | | |  __/ (_| | \__ \   <
 \___|_|\___/|_| |_|\___|\__,_|_|___/_|\_\
EOF
	printf '%45s%s\n' '' "${cmsg_Este_programa_pode_ser_redistribuido_livremente}"
	printf '%45s%s\n' '' "${cmsg_sob_os_termos_da_Licenca_Publica}"
	sh_version
}

sh_usage() {
	printf '%s\n' "${cyan}${cmsg_Uso}${reset}"
	printf '%s\n' "${red}	${_APP_}                ${reset}- ${cmsg_sem_parametros_abre_a_interface}"
	printf '%s\n' "${red}	${_APP_} -h, --help     ${reset}- ${cmsg_exibir_esta_ajuda_e_sair}"
	printf '%s\n' "${red}	${_APP_} -V, --version  ${reset}- ${cmsg_mostrar_versao}"
}

# -h/--help e -V/--version: mostram e saem (sem dialog e sem elevar privilégios)
case "$1" in
-h | --help)
	sh_Language
	sh_usage
	exit 0
	;;
-V | --version)
	sh_Language
	sh_logo
	exit 0
	;;
esac

sh_checkroot() {
	if [[ "$(id -u)" != "0" ]]; then
		elevate_to_root "$@"
	fi
	ccabec+=' [root]'
}

# Cria o arquivo de log da execução (chamado já como root)
sh_log_init() {
	mkdir -p "$LOGDIR" 2>/dev/null
	LOGFILE="$LOGDIR/${_APP_}-$(date '+%Y%m%d-%H%M').log"
	if ! : >>"$LOGFILE" 2>/dev/null; then
		LOGFILE=""
		return 1
	fi
	sh_log "início: $_APP_ v$_VERSION_ | usuário=${SUDO_USER:-$USER} | distro=$(detect_distro) | LANG=$LANG"
	trap 'LOG_OP="" LOG_FN=main sh_log "fim"' EXIT
}

# Grava uma linha no log: data hora [função] mensagem
sh_log() {
	local fn="${LOG_FN:-${FUNCNAME[1]:-main}}"

	[[ -n "$LOGFILE" ]] || return 0
	[[ "$fn" == "sh_log_result" ]] && fn="${FUNCNAME[2]:-main}"
	if [[ -n "$LOG_OP" ]]; then
		printf '%s [%s] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$LOG_OP" "$fn" "$*" >>"$LOGFILE"
	else
		printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$fn" "$*" >>"$LOGFILE"
	fi
}

# Registra o resultado de uma operação com o tempo decorrido
sh_log_result() {
	local status="$1"

	if ((status == 0)); then
		sh_log "resultado: sucesso | tempo=$(sh_time_elapsed)"
	else
		sh_log "resultado: FALHA (status=$status) | tempo=$(sh_time_elapsed)"
	fi
}

sh_diahora() {
	date '+%Y%m%d_%H%M%S'
}

log_exec() {
	"$@" 2>/dev/null
}

log_err() {
	printf " %b %s\\n" "${CROSS}" "${*}"
}

log_info_msg() {
	printf " %b %s\\n" "${INFO}" "${*}"
}

elevate_to_root() {
	log_err "${cmsg_Este_script_precisa_ser_executado_como}"

	# Tenta usar sudo primeiro (caso esteja configurado)
	if has_command sudo; then
		exec sudo bash "$0" "$@"
	fi

	# Se sudo falhar, tenta su
	if has_command su; then
		exec su -c "$(printf '%q ' bash "$0" "$@")"
	fi
	die "${cmsg_Erro_nao_foi_possivel_elevar_os}"
}

DOT() {
	printf "%s" "${blue}:: ${reset}"
}

die() {
	local msg=$1
	shift
	sh_log "ERRO: $msg"
	printf "%-75s\n" "$(DOT)${bold}${red}$msg${reset}" >&2
	exit 1
}

run_dialog_stream() {
	local title="$1"
	shift
	# sem dialog instalado (ele mesmo pode ser uma das dependências), roda direto
	if ! has_command "${DIALOG}"; then
		"$@"
		return $?
	fi
	stdbuf -oL -eL "$@" 2>&1 |
		${DIALOG} \
			--backtitle "$ccabec" \
			--progressbox "$title" 20 70
	local status=${PIPESTATUS[0]}
	return "$status"
}

sh_setup() {
	local DISTRO
	local -a cmds=("$@")
	local -a pkgs=()
	local -A seen=()
	local d

	DISTRO=$(detect_distro)
	((${#cmds[@]})) || cmds=("${DEPENDENCIES[@]}")
	for d in "${cmds[@]}"; do
		[[ -n "${PACKAGEDEP[$d]}" && -z "${seen[${PACKAGEDEP[$d]}]}" ]] || continue
		seen[${PACKAGEDEP[$d]}]=1
		pkgs+=("${PACKAGEDEP[$d]}")
	done

	sh_log "instalando dependências em $DISTRO: ${pkgs[*]}"
	if has_command "${DIALOG}"; then
		msg "$_APP_" "${cmsg_Instalando_pacotes_necessarios}"
	else
		log_info_msg "${cmsg_Instalando_pacotes_necessarios}: ${pkgs[*]}"
	fi

	case "$DISTRO" in
	void | voidlinux | void-live | voidbr)
		if ! run_dialog_stream "${cmsg_Instalando_pacotes_no} ${DISTRO^^}" \
			xbps-install -Sy "${pkgs[@]}"; then
			die "[${cmsg_Error}] ${cmsg_Falha_ao_instalar_pacotes}"
		fi
		;;
	chili | chililinux | arch | manjaro | biglinux | endeavouros)
		if ! run_dialog_stream "${cmsg_Instalando_pacotes_no} ${DISTRO^^}" \
			pacman -S --needed --quiet --noconfirm "${pkgs[@]}"; then
			die "[${cmsg_Error}] ${cmsg_Falha_ao_instalar_pacotes}"
		fi
		;;
	*)
		die "${cmsg_Outra_distro} $DISTRO - ${cmsg_distro_nao_suportada} ${pkgs[*]}"
		;;
	esac
}

sh_checkDependencies() {
	local aBlock_files=()
	local d
	local errorFound=false
	declare -a missing

	for d in "${DEPENDENCIES[@]}"; do
		if ! has_command "$d"; then
			log_err "${red}${cmsg_Error}${reset}: ${cmsg_Nao_foi_possivel_encontrar_o_comando} ${cyan}'$d'${reset} -> ${cmsg_instalar_pacote} ${cyan}${PACKAGEDEP[$d]}${reset}"
			missing+=("$d")
			errorFound=true
		else
			#     log_msg "Check: ${cyan}$d"
			:
		fi
	done

	if $errorFound; then
		replicate '='
		echo "${yellow}             ${cmsg_IMPOSSIVEL_CONTINUAR}"
		echo "${black}${cmsg_Este_script_precisa_dos_comandos_listados}"
		echo "${black}${cmsg_Instale_os_e_ou_verifique_se} ${red}\$PATH${reset}"
		replicate '='
		#die $(gettext "Abortando...")
		if readconf "${cmsg_Deseja_instalar_os_pacotes_e_suprir}"; then
			sh_setup "${missing[@]}"
		else
			exit 1
		fi
	fi
}
export -f sh_checkDependencies

sh_display() {
	if [[ "$(tput cols)" -lt 80 ]] || [[ "$(tput lines)" -lt 24 ]]; then
		dialog --backtitle "$ccabec" \
			--title "${cmsg_TERMINAL_MUITO_PEQUENO}" \
			--msgbox "\n\
${cmsg_Antes_de_continuar_redimensione_seu_terminal}\n\
${cmsg_Caso_contrario_voce_nao_podera_usar}" 11 68
	fi
}

sh_execute_iso2usb() {
	if has_command chili-iso2usb; then
		bash chili-iso2usb
	else
		info "$(printf "${cmsg_Erro_O_utilitario_s_nao_esta}" chili-iso2usb)"
	fi
	return
}

sh_run_binary() {
	local binary="${1}"
	local lang="${2}"
	local grafic="${3}"

	if has_command "${binary}" || has_command ./"${binary}"; then
		bash "${binary}" "$lang" "${grafic}"
		return 0
	fi

	info "${WHITE}${REVERSE}${binary}${RESET}" \
		"\n\n${RED}✗ ${cmsg_binario_nao_foi_localizado_no} ${YELLOW}\$PATH" \
		"\n${RED}✗ ${cmsg_binario_nao_foi_localizado_na_pasta} ${YELLOW}$PWD${RESET}" \
		"${YELLOW}\n➡ ${cmsg_DICA_instale_o_pacote_chili_utils}"
	return 1
}

sh_get_local_ip() {
	local local_ip
	local_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')
	if [[ -z "$local_ip" ]]; then
		echo "192.168.1.100"
	else
		echo "$local_ip"
	fi
}

sh_menu_network_ssh() {
	: "${NET_TITLE:=${cmsg_dir_rede_envia}}"
	local source="$1"
	local txtNetworkData

	local local_ip
	local_ip=$(sh_get_local_ip)

	local base_ip="${local_ip%.*}"

	local ssh_user="root"
	local ssh_ip="${base_ip}.100"
	local ssh_porta="22"
	local ssh_password=""
	local use_sshpass=0
	local format_type=""

	while true; do
		# 1. Chama a nova função modular para obter o formato desejado
		format_type=$(sh_get_network_format)

		if [[ -z "$format_type" ]]; then
			return 1
		fi

		# 2. Define dinamicamente o arquivo padrão com base no formato retornado
		local base_name="${DEVICE_SOURCE//\//_}"
		base_name="${base_name#_}"
		local ssh_outfile="/mnt/backup/${base_name}_remote.img.${format_type}"
		if [[ "$format_type" == "img" ]]; then
			ssh_outfile="/mnt/backup/${base_name}_remote.img"
		fi

		# 3. Abre o formulário com o nome do arquivo já preenchido com a extensão correta
		exec 3>&1
		txtNetworkData=$(${DIALOG} \
			--backtitle "$ccabec" \
			--title "** ${NET_TITLE^^} **" \
			--ok-label "${cmsg_Select}" \
			--cancel-label "${cmsg_button_voltar}" \
			--colors \
			--insecure \
			--mixedform "${cmsg_Entre_com_as_credenciais_do_servidor}" \
			14 90 0 \
			"${cmsg_Usuario_Remoto}" 1 1 "$ssh_user" 1 20 20 0 0 \
			"${cmsg_IP_do_Servidor}" 2 1 "$ssh_ip" 2 20 30 0 0 \
			"${cmsg_Porta_SSH}" 3 1 "$ssh_porta" 3 20 10 0 0 \
			"${cmsg_Arquivo_Destino}" 4 1 "$ssh_outfile" 4 20 60 0 0 \
			2>&1 1>&3)

		local exit_status=$?
		exec 3>&-

		case $exit_status in
		1 | 255)
			# Se voltar no formulário, retorna para a tela de escolha de formato
			continue
			;;
		0)
			mapfile -t aNetData <<<"$txtNetworkData"
			ssh_user="${aNetData[0]}"
			ssh_ip="${aNetData[1]}"
			ssh_porta="${aNetData[2]}"
			ssh_outfile="${aNetData[3]}"

			if [[ -z "$ssh_user" || -z "$ssh_ip" || -z "$ssh_outfile" ]]; then
				conf "*** ${cmsg_CONFIGURACAO_SSH} ***" "\n${cmsg_Todos_os_campos_devem_ser_preenchidos}\n"
				continue
			fi

			sh_ssh_login "$ssh_user" "$ssh_ip" "$ssh_porta" || continue
			use_sshpass=$SSH_USE_PASS
			ssh_password=$SSH_PASSWORD

			sh_make_clone_network_ssh "$source" "$ssh_user" "$ssh_ip" "$ssh_porta" "$ssh_outfile" "$use_sshpass" "$ssh_password" "$format_type"
			local rc=$?
			((rc == 2)) && continue # destino recusado (sem escrita, sem espaço, FAT32...): corrige no formulário
			return $rc
			;;
		esac
	done
}

# Testa acesso SSH: chave pública primeiro; se falhar, pede senha (sshpass).
# Define SSH_USE_PASS (0/1) e SSH_PASSWORD. Retorna 1 se não conseguir acesso.
sh_ssh_login() {
	local user="$1"
	local ip="$2"
	local port="$3"

	SSH_USE_PASS=0
	SSH_PASSWORD=""

	${DIALOG} --title "${cmsg_TESTANDO_CONEXAO}" --infobox "\n${cmsg_Tentando_conexao_via_Chave_Publica_em} $ip..." 5 60
	if ssh -p "$port" -o ConnectTimeout=3 -o BatchMode=yes -o StrictHostKeyChecking=no "$user@$ip" "true" >/dev/null 2>&1; then
		return 0
	fi

	if ! has_command sshpass; then
		conf "*** ${cmsg_ERRO_DE_REQUISITO} ***" "${RED}${cmsg_O_utilitario_sshpass_nao_foi_encontrado}${RESET}\n\n${cmsg_Instale_o_pacote_sshpass_ou_configure}"
		return 1
	fi

	SSH_PASSWORD=$(${DIALOG} --backtitle "$ccabec" --title "${cmsg_AUTENTICACAO_REQUERIDA}" --clear --insecure --passwordbox "${cmsg_A_conexao_direta_por_chave_falhou} $user@$ip:" 10 60 2>&1 >/dev/tty)
	if [[ $? -ne 0 || -z "$SSH_PASSWORD" ]]; then
		return 1
	fi

	${DIALOG} --title "${cmsg_TESTANDO_SENHA}" --infobox "\n${cmsg_Validando_senha_no_servidor_remoto}" 5 60
	if ! SSHPASS="$SSH_PASSWORD" sshpass -e ssh -p "$port" -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$user@$ip" "true" >/dev/null 2>&1; then
		conf "*** ${cmsg_ERRO_DE_AUTENTICACAO} ***" "${RED}${cmsg_Senha_incorreta_ou_acesso_rejeitado_pelo}${RESET}\n${cmsg_Verifique_suas_credenciais_e_tente_novamente}"
		return 1
	fi
	SSH_USE_PASS=1
}

# Monta o comando ssh em SSH_BASE (array), com sshpass -e quando a senha for usada
sh_ssh_base() {
	SSH_BASE=(ssh -p "$3" -o StrictHostKeyChecking=no "$1@$2")
	if ((SSH_USE_PASS)); then
		export SSHPASS="$SSH_PASSWORD"
		SSH_BASE=(sshpass -e "${SSH_BASE[@]}")
	fi
}

sh_get_network_format() {
	local format_type
	format_type=$(${DIALOG} \
		--clear \
		--stdout \
		--backtitle "$ccabec" \
		--title "${cmsg_FORMATO_DE_COMPRESSAO}" \
		--ok-label "${cmsg_Select}" \
		--cancel-label "${cmsg_button_voltar}" \
		--menu "${cmsg_Escolha_o_formato_de_saida_para}" \
		12 60 0 \
		"zst" "Zstandard (${cmsg_Otimizado_Adaptativo})" \
		"gz" "Gzip (${cmsg_Compatibilidade})" \
		"xz" "XZ / LZMA (${cmsg_Maxima_Compressao})" \
		"img" "${cmsg_Sem_compressao_Imagem_Raw_bruto}" \
		2>&1)

	if [[ $? -eq 0 && -n "$format_type" ]]; then
		echo "$format_type"
	else
		echo ""
	fi
}

sh_make_clone_network_ssh() {
	local source="$1"
	local ssh_user="$2"
	local ssh_ip="$3"
	local ssh_porta="$4"
	local ssh_outfile="$5"
	local use_sshpass="$6"
	local ssh_password="$7"
	local format_type="$8"
	local -i nchoice
	set -o pipefail

	if conf "${cwarning}" \
		"$(sh_label_origem "$source"): ${GREEN}$DEVICE_SOURCE${SIZE_SOURCE:+ | $SIZE_SOURCE}${MODEL_SOURCE:+ | $MODEL_SOURCE}${RESET}\n\
${cmsg_SERVIDOR_DESTINO} ${YELLOW}$ssh_user@$ssh_ip:$ssh_porta${RESET}\n\
${cmsg_ARQUIVO_REMOTO} ${RED}$ssh_outfile\n\n" \
		"${BOLD}${YELLOW}${cmsg_Confirmar_o_inicio_da_clonagem_criptografada}${RESET}\n"; then

		sh_start_time_elapsed
		sh_log "origem=$source ($SIZE_SOURCE $MODEL_SOURCE) | destino=$ssh_user@$ssh_ip:$ssh_porta:$ssh_outfile | formato=$format_type | auth=$([[ $use_sshpass -eq 1 ]] && echo senha || echo chave)"
		mensagem "${cmsg_Iniciando_transmissao_de} $source ${cmsg_para} $ssh_ip:$ssh_outfile"

		local src_size
		if [[ -b "$source" ]]; then
			src_size=$(blockdev --getsize64 "$source")
		else
			src_size=$(stat -c%s "$source")
		fi

		SECTOR_SIZE=$(blockdev --getss "$source")

		# Mapeamento limpo sem o bzip2
		local -a compress_cmd=(cat)
		local use_custom_pipeline=0

		case "$format_type" in
		zst) compress_cmd=(zstd --adapt=min=1,max=9 -T2) ;;
		gz) compress_cmd=(gzip -c) ;;
		xz) compress_cmd=(xz -c -T2) ;;
		img) compress_cmd=(cat) ;;
		qcow2) use_custom_pipeline=1 ;;
		*) compress_cmd=(zstd --adapt=min=1,max=9 -T2) ;;
		esac

		# ssh montado em array (sem eval); senha via ambiente, não aparece no ps
		local -a ssh_base=(ssh -p "$ssh_porta" -o StrictHostKeyChecking=no "$ssh_user@$ssh_ip")
		if [[ "$use_sshpass" -eq 1 ]]; then
			export SSHPASS="$ssh_password"
			ssh_base=(sshpass -e "${ssh_base[@]}")
		fi

		local remote_dir
		remote_dir=$(dirname "$ssh_outfile")

		SSH_BASE=("${ssh_base[@]}")
		RSUDO=""
		REMOTE_HOST="$ssh_user@$ssh_ip"
		if ! sh_remote_check_tools "mkdir cat" "df sha256sum"; then
			unset SSHPASS
			return 2 # volta ao formulário
		fi

		${DIALOG} --title "${cmsg_PREPARANDO_DESTINO}" --infobox "\n${cmsg_Garantindo_que_o_diretorio_remoto_existe}" 5 60
		if ! "${ssh_base[@]}" "mkdir -p $(printf '%q' "$remote_dir")" >/dev/null 2>&1; then
			sh_log "falha ao criar diretório remoto: $ssh_user@$ssh_ip:$remote_dir"
			conf "*** ${cmsg_ERRO_DE_DIRETORIO} ***" "${RED}${cmsg_Falha_ao_criar_o_diretorio_remoto}${RESET} $remote_dir\n${cmsg_Verifique_as_permissoes_de_escrita_do}"
			unset SSHPASS
			return 2 # volta ao formulário
		fi

		# arquivo remoto já existe: pergunta antes de sobrescrever
		if "${ssh_base[@]}" "test -e $(printf '%q' "$ssh_outfile")" >/dev/null 2>&1; then
			if ! conf "${cwarning}" "\n$(printf "${cmsg_arquivo_remoto_existe}" "$ssh_user@$ssh_ip:$ssh_outfile")"; then
				sh_log "cancelado: arquivo remoto já existe ($ssh_outfile)"
				unset SSHPASS
				return 2 # volta ao formulário
			fi
		fi

		# onde o arquivo vai ficar e quanto espaço há no remoto
		# dá para criar arquivo no diretório remoto?
		if ! "${ssh_base[@]}" "p=$(printf '%q' "$remote_dir")/.${_APP_}.\$\$.probe; : > \"\$p\" && rm -f \"\$p\"" >/dev/null 2>&1; then
			info "$(printf "${cmsg_sem_escrita}" "$ssh_user@$ssh_ip:$remote_dir")"
			unset SSHPASS
			return 2 # volta ao formulário
		fi

		# onde o arquivo vai ficar, tipo do sistema de arquivos e espaço livre no remoto
		local r_src r_fstype r_avail
		# df -P é POSIX (existe no BusyBox, que não tem --output); o tipo vem do /proc/mounts
		read -r r_src r_fstype r_avail < <("${ssh_base[@]}" "set -- \$(df -Pk $(printf '%q' "$remote_dir") | tail -n1); fs=\$(awk -v m=\"\$6\" '\$2==m{f=\$3} END{print f}' /proc/mounts); echo \"\$1 \$fs \$((\$4 * 1024))\"" 2>/dev/null)

		# remoto = esta máquina e o arquivo cairia no próprio disco de origem
		if [[ "$("${ssh_base[@]}" "cat /proc/sys/kernel/random/boot_id" 2>/dev/null)" == "$(cat /proc/sys/kernel/random/boot_id)" ]] &&
			[[ -n "$r_src" ]] && lsblk -nrpo NAME "$source" 2>/dev/null | grep -Fxq "$r_src"; then
			info "$(printf "${cmsg_imagem_no_disco_de_origem}" "$remote_dir" "$source")"
			unset SSHPASS
			return 2 # volta ao formulário
		fi

		# FAT32 e espaço livre (mesmas regras do destino local)
		if ! sh_check_image_space "$ssh_user@$ssh_ip:$remote_dir" "$r_fstype" "$r_avail" "$src_size" "$format_type"; then
			unset SSHPASS
			return 2 # volta ao formulário
		fi

		local chash="/tmp/${_APP_}.chash.$$"
		rm -f "$chash"
		local fifo_tmp="/tmp/clonereder_fifo_$$"
		rm -f "$fifo_tmp"
		mkfifo "$fifo_tmp"

		local remote_cat
		remote_cat="cat > $(printf '%q' "$ssh_outfile")"

		# subshell com pipefail: o wait devolve a falha de qualquer etapa (compressor ou ssh)
		if [[ "$use_custom_pipeline" -eq 1 ]]; then
			(
				set -o pipefail
				qemu-img convert -O qcow2 "$fifo_tmp" /dev/stdout | "${ssh_base[@]}" "$remote_cat" 2>/dev/null
			) &
		else
			(
				set -o pipefail
				"${compress_cmd[@]}" <"$fifo_tmp" | "${ssh_base[@]}" "$remote_cat" 2>/dev/null
			) &
		fi
		local network_pid=$!

		(
			pv --numeric --size "$src_size" "$source" | tee >(sha256sum | cut -d' ' -f1 >"$chash") >"$fifo_tmp"
		) 2>&1 |
			${DIALOG} \
				--title "${cmsg_CLONAGEM_REMOTA_EM_ANDAMENTO}" \
				--colors \
				--gauge \
				"${BOLD}${WHITE}${REVERSE}${cmsg_Processando_pv_conversor_compressor_SSH_Rede}${RESET}\n\n\
$(sh_label_origem "$source"): ${YELLOW}$DEVICE_SOURCE ($SIZE_SOURCE)${RESET}\n\
${cmsg_DESTINO_REMOTO} ${RED}$ssh_ip:$ssh_outfile${RESET}" \
				11 100 0

		nchoice=${PIPESTATUS[0]} # status do pv (o [1] era o do dialog)

		wait "$network_pid" || nchoice=1
		if ((nchoice != 0)); then
			"${ssh_base[@]}" "rm -f $(printf '%q' "$ssh_outfile")" >/dev/null 2>&1 &&
				sh_log "arquivo incompleto removido: $ssh_user@$ssh_ip:$ssh_outfile"
		fi
		rm -f "$fifo_tmp"

		sh_end_time_elapsed
		sh_log_result "$nchoice"

		if [[ $nchoice -eq 0 ]]; then
			# ficha e hash gravados ao lado da imagem, no remoto
			SSH_BASE=("${ssh_base[@]}")
			RSUDO=""
			REMOTE_HOST="$ssh_user@$ssh_ip"
			sh_meta_from_local_dev "$source"
			META_FORMAT="$format_type"
			META_CONTENT_BYTES="$src_size"
			META_CONTENT_HASH=""
			sh_wait_file "$chash" && META_CONTENT_HASH="$(<"$chash")"
			sh_write_image_meta "$ssh_outfile" remote
		fi
		rm -f "$chash"

		if [[ $nchoice -eq 0 ]]; then
			local remote_size="N/A"
			remote_size=$("${ssh_base[@]}" "du -sh $(printf '%q' "$ssh_outfile")" 2>/dev/null | awk '{print $1}')
			[[ -z "$remote_size" ]] && remote_size="Unknown"

			display_result \
				"${cmsg_Resumo_da_Operacao_de_Rede}" \
				"${BOLD}${GREEN}${REVERSE}${cmsg_Clonagem_Remota_Concluida_com_Sucesso}${RESET}\n\n" \
				"${cmsg_Origem_Local} ${BOLD}${WHITE}$source${RESET}\n" \
				"${cmsg_Destino_Remoto} ${BOLD}${WHITE}$ssh_user@$ssh_ip:$ssh_outfile${RESET}\n" \
				"${cmsg_Tamanho_Remoto} ${BOLD}${YELLOW}$remote_size${RESET}\n\n" \
				"$(sh_time_summary)"
		else
			info "${cmsg_Falha_clonagem_remota}"
		fi

		unset SSHPASS
		return $nchoice
	fi
	return 1
}

sh_clone_network_ssh() {
	local kind="${1:-disk}" # disk | part
	local title="${cmsg_dir_rede_envia}"

	if [[ "$kind" == "part" ]]; then
		title="${cmsg_dir_rede_lpart_img}"
		source=$(sh_list_partition "${cmsg_part_origem}" "" origem)
		[[ -n "$source" ]] || return 1
		sh_part_info
	else
		source=$(sh_list_disk "${cmsg_SELECIONE_O_DISCO_DE_ORIGEM_PARA}" "" origem)
		[[ -n "$source" ]] || return 1
		sh_disk_info
	fi
	DEVICE_SOURCE="$source"
	MODEL_SOURCE="$(sh_splitarray "${AARRAY_DSK_DEVICES[$source]}" "$DSK_MODEL")"
	SIZE_SOURCE="$(sh_splitarray "${AARRAY_DSK_DEVICES[$source]}" "$DSK_SIZE")"

	sh_check_source_busy "$source" || return 1
	NET_TITLE="$title"
	sh_menu_network_ssh "$source"
}

# --keep-tite \
# Discos locais em uso pelo sistema: os que contêm /, /boot, /boot/efi, /usr, /var, /home ou swap ativa
declare -a SYSTEM_MOUNTS=(/ /boot /boot/efi /usr /var /home)
sh_system_disks() {
	local mp src
	{
		for mp in "${SYSTEM_MOUNTS[@]}"; do
			src="$(findmnt -n -o SOURCE "$mp" 2>/dev/null)"
			src="${src%%\[*}" # btrfs: /dev/sda2[/@] -> /dev/sda2
			[[ -b "$src" ]] && echo "$src"
		done
		swapon --show=NAME --noheadings 2>/dev/null
	} | while read -r src; do
		[[ -b "$src" ]] || continue
		lsblk -nrspo NAME,TYPE "$src" 2>/dev/null | awk '$2 == "disk" || $2 == "loop" {print $1}'
	done | sort -u
}

# Confere, com um só comando SSH, as ferramentas do computador remoto.
#   uso: sh_remote_check_tools "obrigatória ..." "opcional ..."
# Falta obrigatória: mostra o que falta (e o pacote) e retorna 1.
# Falta opcional: segue e registra no log o que deixa de ser feito.
# Pacote de cada ferramenta conforme a família da distro remota
#   uso: sh_tool_pkg ferramenta familia   (familia: void arch debian fedora alpine suse)
sh_tool_pkg() {
	local t="$1"
	local fam="$2"
	case "$t" in
	lsblk | blockdev | partx | blkid) echo "util-linux" ;;
	sfdisk | fdisk) [[ "$fam" == "debian" ]] && echo "fdisk" || echo "util-linux" ;;
	dd | cat | sha256sum | stat | df | mkdir | readlink) echo "coreutils" ;;
	awk) echo "gawk" ;;
	fuser) echo "psmisc" ;;
	xz) [[ "$fam" == "debian" ]] && echo "xz-utils" || echo "xz" ;;
	*) echo "$t" ;;
	esac
}

# Comando de instalação conforme a família da distro remota
sh_install_cmd() {
	case "$1" in
	void) echo "xbps-install -S" ;;
	arch) echo "pacman -S --needed" ;;
	debian) echo "apt install" ;;
	fedora) echo "dnf install" ;;
	alpine) echo "apk add" ;;
	suse) echo "zypper install" ;;
	*) echo "" ;;
	esac
}

# O que deixa de ser feito quando falta uma ferramenta opcional
sh_tool_desc() {
	case "$1" in
	fuser) echo "${cmsg_tool_fuser}" ;;
	blkid) echo "${cmsg_tool_blkid}" ;;
	sfdisk) echo "${cmsg_tool_sfdisk}" ;;
	partx) echo "${cmsg_tool_partx}" ;;
	fdisk) echo "${cmsg_tool_fdisk}" ;;
	sha256sum) echo "${cmsg_tool_sha256sum}" ;;
	zstd | xz | gzip) echo "${cmsg_tool_compress}" ;;
	df) echo "${cmsg_tool_df}" ;;
	*) echo "" ;;
	esac
}

# Confere, com um só comando SSH, as ferramentas do computador remoto.
#   uso: sh_remote_check_tools "obrigatória ..." "opcional ..."
# Mostra uma tela com o que falta (obrigatórias e opcionais), o pacote de cada uma,
# o comando para instalar na distro remota, e salva um manifesto em /tmp.
# Falta obrigatória: retorna 1. Só opcionais: pergunta se quer prosseguir.
sh_remote_check_tools() {
	local req="$1"
	local opt="$2"
	local t line pk fam="" rid="" pkgs="" text="" missing_req="" missing_opt=""
	local -A have=() seen=()

	while IFS= read -r line; do
		case "$line" in
		__ID__*) rid="${line#__ID__ }" ;;
		?*) have[$line]=1 ;;
		esac
	done < <("${SSH_BASE[@]}" "$RSUDO sh -c 'for t in $req $opt; do command -v \$t >/dev/null 2>&1 && echo \$t; done; . /etc/os-release 2>/dev/null; echo \"__ID__ \$ID \$ID_LIKE\"'" 2>/dev/null)

	for t in $req; do [[ -n "${have[$t]}" ]] || missing_req+=" $t"; done
	for t in $opt; do [[ -n "${have[$t]}" ]] || missing_opt+=" $t"; done
	[[ -z "$missing_req$missing_opt" ]] && return 0

	# família da distro remota (ID e depois ID_LIKE)
	for t in $rid; do
		case "$t" in
		void*) fam=void ;;
		arch | chili* | manjaro | endeavouros | biglinux) fam=arch ;;
		debian | ubuntu | linuxmint | pop) fam=debian ;;
		fedora | rhel | centos | rocky | almalinux) fam=fedora ;;
		alpine) fam=alpine ;;
		opensuse* | suse | sles) fam=suse ;;
		esac
		[[ -n "$fam" ]] && break
	done

	if [[ -n "$missing_req" ]]; then
		text+="${cmsg_tools_obrigatorias}\n"
		for t in $missing_req; do
			text+="$(printf '  • %-10s %s' "$t" "$(sh_tool_pkg "$t" "$fam")")\n"
			pk="$(sh_tool_pkg "$t" "$fam")"
			if [[ -z "${seen[$pk]}" ]]; then
				pkgs="$pkgs $pk"
				seen[$pk]=1
			fi
		done
		text+="\n"
	fi
	if [[ -n "$missing_opt" ]]; then
		text+="${cmsg_tools_opcionais}\n"
		for t in $missing_opt; do
			text+="$(printf '  • %-10s %-12s %s' "$t" "$(sh_tool_pkg "$t" "$fam")" "$(sh_tool_desc "$t")")\n"
			pk="$(sh_tool_pkg "$t" "$fam")"
			if [[ -z "${seen[$pk]}" ]]; then
				pkgs="$pkgs $pk"
				seen[$pk]=1
			fi
		done
		text+="\n"
	fi
	local cmd
	cmd="$(sh_install_cmd "$fam")"
	if [[ -n "$cmd" ]]; then
		text+="$(printf "${cmsg_tools_comando}" "${rid%% *}")\n  $cmd$pkgs\n"
	else
		text+="$(printf "${cmsg_tools_pacotes}" "${rid%% *}")\n $pkgs\n"
	fi

	# manifesto salvo para copiar e colar no remoto
	local manifest="/tmp/${_APP_}-remoto-${REMOTE_HOST#*@}-$(date '+%Y%m%d-%H%M%S').txt"
	{
		echo "# ${_APP_} - ferramentas ausentes no computador remoto"
		echo "remoto=$REMOTE_HOST"
		echo "distro=${rid:-?}"
		echo "data=$(date '+%Y-%m-%d %H:%M:%S %z')"
		echo "obrigatorias_ausentes=${missing_req# }"
		echo "opcionais_ausentes=${missing_opt# }"
		echo "pacotes=${pkgs# }"
		[[ -n "$cmd" ]] && echo "comando=$cmd$pkgs"
	} >"$manifest" 2>/dev/null
	text+="\n$(printf "${cmsg_tools_manifesto}" "$manifest")"
	sh_log "remoto $REMOTE_HOST | obrigatórias ausentes:${missing_req:- nenhuma} | opcionais ausentes:${missing_opt:- nenhuma} | manifesto: $manifest"

	if [[ -n "$missing_req" ]]; then
		alerta "${cwarning}" "\n$(printf "${cmsg_remoto_sem_ferramentas}" "$REMOTE_HOST")\n\n$text"
		return 1
	fi
	conf "${cwarning}" "\n$(printf "${cmsg_remoto_ferramentas_opcionais}" "$REMOTE_HOST")\n\n$text\n\n${cmsg_Prosseguir}"
}

# Nome do tipo de partição a partir do código da tabela (GUID do GPT ou hex do MBR).
# Usado quando o lsblk remoto não informa PARTTYPENAME (sem udev ou util-linux antigo).
sh_parttype_name() {
	case "${1,,}" in
	21686148-6449-6e6f-744e-656564454649) echo "BIOS boot" ;;
	c12a7328-f81f-11d2-ba4b-00a0c93ec93b | 0xef) echo "EFI System" ;;
	e3c9e316-0b5c-4db8-817d-f92df00215ae) echo "Microsoft reserved" ;;
	ebd0a0a2-b9e5-4433-87c0-68b6b72699c7) echo "Microsoft basic data" ;;
	de94bba4-06d1-4d40-a16a-bfd50179d6ac | 0x27) echo "Windows recovery" ;;
	0fc63daf-8483-4772-8e79-3d69d8477de4 | 0x83) echo "Linux filesystem" ;;
	0657fd6d-a4ab-43c4-84e5-0933c84b4f4f | 0x82) echo "Linux swap" ;;
	e6d6d379-f507-44c2-a23c-238f2a3df928 | 0x8e) echo "Linux LVM" ;;
	a19d880f-05fc-4d3b-a006-743f0f84911e | 0xfd) echo "Linux RAID" ;;
	bc13c2ff-59e6-4262-a352-b275fd6f7172) echo "Linux extended boot" ;;
	0x5 | 0xf | 0x85) echo "Extended" ;;
	0x7) echo "NTFS/exFAT" ;;
	0xb | 0xc) echo "FAT32" ;;
	*) echo "" ;;
	esac
}

# Conecta num servidor SSH e escolhe um disco remoto.
# Define: REMOTE_HOST (usuario@ip), REMOTE_DEV, REMOTE_SIZE (bytes), REMOTE_DESC, REMOTE_SECTOR, RSUDO e SSH_BASE.
sh_remote_pick_disk() {
	local title="$1"
	local mode="${2:-origem}" # origem (vai ser lido) | destino (vai ser sobrescrito)
	local kind="${3:-disk}"   # disk (disco/loop/LVM) | part (partição)
	REMOTE_KIND="$kind"
	local ssh_user="root" ssh_porta="22" ssh_ip txt local_ip line key val
	local -a fields=() items=()
	local -A seen=()

	local_ip=$(sh_get_local_ip)
	ssh_ip="${local_ip%.*}.100"

	while true; do
		exec 3>&1
		txt=$(${DIALOG} \
			--backtitle "$ccabec" \
			--title "** ${title^^} **" \
			--ok-label "${cmsg_Select}" \
			--cancel-label "${cmsg_button_voltar}" \
			--colors \
			--mixedform "${cmsg_credenciais_servidor}" \
			12 90 0 \
			"${cmsg_Usuario_Remoto}" 1 1 "$ssh_user" 1 20 20 0 0 \
			"${cmsg_IP_do_Servidor}" 2 1 "$ssh_ip" 2 20 30 0 0 \
			"${cmsg_Porta_SSH}" 3 1 "$ssh_porta" 3 20 10 0 0 \
			2>&1 1>&3)
		local st=$?
		exec 3>&-
		((st == 0)) || return 1

		mapfile -t fields <<<"$txt"
		ssh_user="${fields[0]}"
		ssh_ip="${fields[1]}"
		ssh_porta="${fields[2]}"
		if [[ -z "$ssh_user" || -z "$ssh_ip" || -z "$ssh_porta" ]]; then
			conf "*** ${cmsg_CONFIGURACAO_SSH} ***" "\n${cmsg_Todos_os_campos_devem_ser_preenchidos}\n"
			continue
		fi

		sh_ssh_login "$ssh_user" "$ssh_ip" "$ssh_porta" || continue
		sh_ssh_base "$ssh_user" "$ssh_ip" "$ssh_porta"

		# ler disco cru exige root: sudo sem senha quando o usuário não é root
		# root pelo uid (não pelo nome); sem id no remoto, decide pelo nome
		RSUDO=""
		local ruid
		ruid="$("${SSH_BASE[@]}" "id -u" 2>/dev/null)"
		if [[ "$ruid" =~ ^[0-9]+$ ]]; then
			((ruid == 0)) || RSUDO="sudo -n"
		elif [[ "$ssh_user" != "root" ]]; then
			RSUDO="sudo -n"
		fi
		if ! "${SSH_BASE[@]}" "$RSUDO true" >/dev/null 2>&1; then
			info "${cmsg_remoto_sem_root}"
			unset SSHPASS
			continue
		fi

		# ferramentas: ler um disco remoto / gravar num disco remoto
		REMOTE_HOST="$ssh_user@$ssh_ip"
		local req="lsblk awk readlink blockdev cat" opt="fuser blkid"
		[[ "$mode" == "destino" ]] && req="lsblk awk readlink blockdev dd" opt="fuser blkid sfdisk partx fdisk sha256sum"
		if ! sh_remote_check_tools "$req" "$opt"; then
			unset SSHPASS
			continue
		fi
		break
	done

	# o "remoto" pode ser esta mesma máquina (ex.: 127.0.0.1): compara o boot_id
	SAME_MACHINE=0
	if [[ "$("${SSH_BASE[@]}" "cat /proc/sys/kernel/random/boot_id" 2>/dev/null)" == "$(cat /proc/sys/kernel/random/boot_id)" ]]; then
		SAME_MACHINE=1
		sh_log "remoto $ssh_user@$ssh_ip é esta mesma máquina"
	fi

	# discos remotos (disco, loop e LVM), sem repetidos e sem volumes internos do LVM
	local -A r_type=() r_size=() r_tran=() r_model=() r_busy=() r_fs=() r_label=() r_ptype=()
	local -a r_order=()
	while IFS= read -r line; do
		local -A f=()
		# lê KEY="valor" sem eval (a saída vem de outra máquina)
		while [[ "$line" =~ ^[[:space:]]*([A-Z:-]+)=\"([^\"]*)\"(.*)$ ]]; do
			key="${BASH_REMATCH[1]}"
			val="$(printf '%b' "${BASH_REMATCH[2]}")"
			f[$key]="$val"
			line="${BASH_REMATCH[3]}"
		done
		local path="${f[PATH]}"
		[[ -z "$path" ]] && continue
		if [[ "$kind" == "part" ]]; then
			[[ "${f[TYPE]}" == "part" ]] || continue
		else
			case "${f[TYPE]}" in
			disk | loop | lvm) ;;
			*) continue ;;
			esac
		fi
		[[ "${f[NAME]}" =~ ^(zram|ram)[0-9]+$ || "${f[SIZE]}" == "0" ]] && continue
		[[ "${f[TYPE]}" == "lvm" && "${f[NAME]}" =~ (_tdata|_tmeta|_tpool|-tpool|_rimage_[0-9]+|_rmeta_[0-9]+|_mimage_[0-9]+|_mlog|_cdata|_cmeta|_corig|_cvol|_vorigin|_pmspare)$ ]] && continue
		[[ -n "${seen[$path]}" ]] && continue
		seen[$path]=1
		r_order+=("$path")
		r_type[$path]="${f[TYPE]}"
		r_size[$path]="${f[SIZE]}"
		r_tran[$path]="${f[TRAN]:-${f[TYPE]}}"
		r_model[$path]="${f[MODEL]:-${f[TYPE]} device}"
		r_fs[$path]="${f[FSTYPE]}"
		r_label[$path]="${f[LABEL]}"
		r_ptype[$path]="${f[PARTTYPENAME]}"
	done < <(
		# PARTTYPENAME não existe em util-linux antigo: sem ela o lsblk falharia inteiro
		"${SSH_BASE[@]}" "$RSUDO lsblk -PAbo NAME,PATH,TYPE,SIZE,TRAN,MODEL,FSTYPE,LABEL,PARTTYPENAME 2>/dev/null ||
			$RSUDO lsblk -PAbo NAME,PATH,TYPE,SIZE,TRAN,MODEL,FSTYPE,LABEL" 2>/dev/null
	)

	# sem udev o lsblk remoto pode não trazer tipo/rótulo: completa com blkid -p
	# (lê direto do dispositivo; também dá o código do tipo de partição)
	if [[ "$kind" == "part" ]] && ((${#r_order[@]})); then
		local dn="" bt="" bl="" bp=""
		while IFS= read -r line; do
			case "$line" in
			DEVNAME=*) dn="${line#DEVNAME=}" bt="" bl="" bp="" ;;
			TYPE=*) bt="${line#TYPE=}" ;;
			LABEL=*) bl="${line#LABEL=}" ;;
			PART_ENTRY_TYPE=*) bp="${line#PART_ENTRY_TYPE=}" ;;
			"")
				if [[ -n "$dn" ]]; then
					[[ -z "${r_fs[$dn]}" ]] && r_fs[$dn]="$bt"
					[[ -z "${r_label[$dn]}" ]] && r_label[$dn]="$bl"
					[[ -z "${r_ptype[$dn]}" && -n "$bp" ]] && r_ptype[$dn]="$(sh_parttype_name "$bp")"
				fi
				dn=""
				;;
			esac
		done < <("${SSH_BASE[@]}" "for d in $(printf '%q ' "${r_order[@]}"); do $RSUDO blkid -p -o export \"\$d\" 2>/dev/null || $RSUDO blkid -o export \"\$d\"; echo; done" 2>/dev/null)
	fi

	# em uso (montado, swap, LVM/LUKS/RAID, processo, ZFS): uma só consulta para todos
	if ((${#r_order[@]})); then
		while IFS= read -r line; do
			[[ -n "$line" ]] && r_busy[${line%%|*}]=1
		done < <("${SSH_BASE[@]}" "$RSUDO sh -s -- $(printf '%q ' "${r_order[@]}")" <<<"$BUSY_SH" 2>/dev/null)
	fi

	if ((${#r_order[@]} == 0)); then
		info "${cmsg_nenhum_disco_remoto}"
		unset SSHPASS
		return 1
	fi

	# coluna FS: sistema de arquivos, ou "none" quando não há (ex.: BIOS boot, Microsoft reserved)
	sh_rpart_fs() { echo "${r_fs[$1]:-none}"; }
	# coluna rótulo: rótulo; sem sistema de arquivos, mostra o tipo da partição entre parênteses
	sh_rpart_label() {
		if [[ -n "${r_label[$1]}" ]]; then
			echo "${r_label[$1]}"
		elif [[ -z "${r_fs[$1]}" ]]; then
			echo "(${r_ptype[$1]:-${cmsg_sem_fs}})"
		fi
	}

	local d desc
	for d in "${r_order[@]}"; do
		if [[ "$kind" == "part" ]]; then
			desc="$(printf "$sep%-12s$sep%7s$sep%-24s" "$(sh_rpart_fs "$d")" "$(numfmt --to=iec "${r_size[$d]}")" "$(sh_rpart_label "$d")")"
		else
			desc="$(printf "$sep%-6s$sep%7s$sep%-30s" "${r_tran[$d]}" "$(numfmt --to=iec "${r_size[$d]}")" "${r_model[$d]}")"
		fi
		[[ -n "${r_busy[$d]}" ]] && desc+=" ${RED}[${cmsg_em_uso}]${RESET}"
		items+=("$d" "$desc")
	done

	local prompt="${YELLOW}${cmsg_disco_origem} : ${REVERSE}(${cmsg_choose_disk_origem})${RESET}"
	[[ "$mode" == "destino" ]] && prompt="${YELLOW}${cmsg_disco_destino} : ${REVERSE}(${cmsg_choose_disk_destino})${RESET}"
	local rtitle="${cmsg_Disco_remoto}"
	if [[ "$kind" == "part" ]]; then
		prompt="${YELLOW}${cmsg_part_origem} : ${REVERSE}(${cmsg_choose_part_origem})${RESET}"
		[[ "$mode" == "destino" ]] && prompt="${YELLOW}${cmsg_part_destino} : ${REVERSE}(${cmsg_choose_part_destino})${RESET}"
		rtitle="${cmsg_Particao_remota}"
	fi
	REMOTE_HOST="$ssh_user@$ssh_ip"

	while true; do
		REMOTE_DEV=$(${DIALOG} \
			--stdout \
			--colors \
			--backtitle "$ccabec" \
			--title "${rtitle^^}: $ssh_user@$ssh_ip" \
			--ok-label "${cmsg_Select}" \
			--cancel-label "${cmsg_button_voltar}" \
			--default-item "$REMOTE_DEV" \
			--menu "$prompt" \
			20 100 12 "${items[@]}") || {
			unset SSHPASS
			return 1
		}
		[[ "$mode" != "destino" ]] && break
		# destino: nunca sobrescrever disco remoto em uso
		sh_check_target_free "$REMOTE_DEV" remote && break
	done

	REMOTE_SIZE="${r_size[$REMOTE_DEV]}"
	REMOTE_DESC="$(numfmt --to=iec "$REMOTE_SIZE") | ${r_model[$REMOTE_DEV]}"
	if [[ "$kind" == "part" ]]; then
		REMOTE_DESC="$(numfmt --to=iec "$REMOTE_SIZE") | $(sh_rpart_fs "$REMOTE_DEV")"
		[[ -n "$(sh_rpart_label "$REMOTE_DEV")" ]] && REMOTE_DESC+=" | $(sh_rpart_label "$REMOTE_DEV")"
	fi
	REMOTE_SECTOR="$("${SSH_BASE[@]}" "$RSUDO blockdev --getss $(printf '%q' "$REMOTE_DEV")" 2>/dev/null)"
	[[ "$REMOTE_SECTOR" =~ ^[0-9]+$ ]] || REMOTE_SECTOR=512

	# origem remota em uso: avisa (cópia pode ficar inconsistente)
	if [[ "$mode" != "destino" ]] && ! sh_check_source_busy "$REMOTE_DEV" remote; then
		unset SSHPASS
		return 1
	fi
	return 0
}

# Remoto é esta máquina e os dois caminhos apontam para o mesmo dispositivo?
sh_same_device() {
	((SAME_MACHINE)) || return 1
	[[ "$(lsblk -ndo MAJ:MIN "$1" 2>/dev/null)" == "$(lsblk -ndo MAJ:MIN "$2" 2>/dev/null)" ]]
}

# Disco deste computador -> disco de um servidor SSH (nunca um disco remoto em uso)
sh_local_disk_to_remote_disk() {
	local -i nchoice
	local src lsize dumpfile
	local kind="${1:-disk}" # disk | part
	local title="${cmsg_dir_rede_disco_disco}" lbl_src="${cmsg_disco_origem}" lbl_dst="${cmsg_disco_destino}"
	local msg_menor="${cmsg_O_disco_de_DESTINO_e_menor}"

	if [[ "$kind" == "part" ]]; then
		title="${cmsg_dir_rede_lpart_rpart}"
		lbl_src="${cmsg_part_origem}"
		lbl_dst="${cmsg_part_destino}"
		msg_menor="${cmsg_A_particao_de_DESTINO_e_menor}"
		src=$(sh_list_partition "${cmsg_part_origem}" "" origem)
		[[ -z "$src" ]] && return 1
		sh_part_info
	else
		src=$(sh_list_disk "${cmsg_disco_origem}" "" origem)
		[[ -z "$src" ]] && return 1
		sh_disk_info
	fi
	DEVICE_SOURCE="$src"
	MODEL_SOURCE="$(sh_splitarray "${AARRAY_DSK_DEVICES[$src]}" "$DSK_MODEL")"
	SIZE_SOURCE="$(sh_splitarray "${AARRAY_DSK_DEVICES[$src]}" "$DSK_SIZE")"
	sh_check_source_busy "$src" || return 1
	lsize=$(blockdev --getsize64 "$src")

	# destino remoto: em uso é recusado dentro do sh_remote_pick_disk
	sh_remote_pick_disk "$title" destino "$kind" || return 1

	if sh_same_device "$src" "$REMOTE_DEV"; then
		alerta "${cwarning}" "\n${cmsg_disco_identico}\n\n$src = $REMOTE_HOST:$REMOTE_DEV"
		unset SSHPASS
		return 1
	fi

	if ((lsize > REMOTE_SIZE)); then
		conf "${YELLOW}${cwarning}" \
			"\n${BOLD}${RED}${REVERSE}${msg_menor}${RESET}\n\n" \
			"${BOLD}${WHITE}${lbl_src} : $src${SIZE_SOURCE:+ | $SIZE_SOURCE}${MODEL_SOURCE:+ | $MODEL_SOURCE}\n" \
			"${BOLD}${WHITE}${lbl_dst}: $REMOTE_HOST:$REMOTE_DEV | $REMOTE_DESC${RESET}\n\n" \
			"${YELLOW}${cmsg_Prosseguir}" || {
			unset SSHPASS
			return 1
		}
	fi

	if ! conf "${cwarning}" \
		"\n${cmsg_todos_os_dados_serao_perdidos}\n\n""\
${BLUE} ${lbl_src}:  $src${SIZE_SOURCE:+ | $SIZE_SOURCE}${MODEL_SOURCE:+ | $MODEL_SOURCE} \n" \
		"${RED}${lbl_dst}: $REMOTE_HOST:$REMOTE_DEV | $REMOTE_DESC\n\n" \
		"${BOLD}${WHITE}${cmsg_continuar_com_a_clonagem}?\n"; then
		unset SSHPASS
		return 1
	fi

	# confere de novo logo antes de gravar (algo pode ter montado o disco nesse meio tempo)
	if ! sh_check_target_free "$REMOTE_DEV" remote; then
		unset SSHPASS
		return 1
	fi

	# backup da tabela de partições do disco remoto, guardado aqui (partição não tem tabela)
	[[ "$kind" == "part" ]] || {
	mkdir -p "/tmp/$_APP_"
	dumpfile="/tmp/$_APP_/${REMOTE_HOST#*@}_${REMOTE_DEV##*/}.$(sh_diahora).dump"
	if "${SSH_BASE[@]}" "$RSUDO sfdisk -d $(printf '%q' "$REMOTE_DEV")" >"$dumpfile" 2>/dev/null; then
		sh_log "backup da tabela de partições: $REMOTE_HOST:$REMOTE_DEV -> $dumpfile"
	else
		rm -f "$dumpfile"
		sh_log "sem tabela de partições para backup: $REMOTE_HOST:$REMOTE_DEV"
	fi
	}

	sh_start_time_elapsed
	local chash="/tmp/${_APP_}.chash.$$"
	rm -f "$chash"
	sh_log "origem=$src ($SIZE_SOURCE $MODEL_SOURCE) | destino=$REMOTE_HOST:$REMOTE_DEV ($REMOTE_DESC) | auth=$( ((SSH_USE_PASS)) && echo senha || echo chave)"
	(
		set -o pipefail
		pv -n "$src" |
			tee >(sha256sum | cut -d' ' -f1 >"$chash") |
			"${SSH_BASE[@]}" "$RSUDO dd of=$(printf '%q' "$REMOTE_DEV") bs=4M iflag=fullblock conv=notrunc,fsync status=none" 2>>"${LOGFILE:-/dev/null}"
	) 2>&1 |
		${DIALOG} \
			--title "${cmsg_running_disk_cloning^^}" \
			--colors \
			--gauge \
			"${BOLD}${WHITE}${REVERSE}${cmsg_running_disk_cloning} (pv -> ssh -> dd)${RESET}\n\n\
${cmsg_Origem^^} : ${YELLOW}$src${SIZE_SOURCE:+ | $SIZE_SOURCE}${MODEL_SOURCE:+ | $MODEL_SOURCE}${RESET}\n\
${cmsg_Destino^^}: ${RED}$REMOTE_HOST:$REMOTE_DEV | $REMOTE_DESC${RESET}" \
			10 100 0
	nchoice=${PIPESTATUS[0]}

	# o kernel remoto relê a tabela para as partições novas aparecerem lá
	if ((nchoice == 0)) && [[ "$kind" != "part" ]]; then
		"${SSH_BASE[@]}" "$RSUDO sh -c 'blockdev --rereadpt $(printf '%q' "$REMOTE_DEV") 2>/dev/null; partx -u $(printf '%q' "$REMOTE_DEV") 2>/dev/null; true'" >/dev/null 2>&1
	fi
	# verificação: relê o disco remoto e compara com o hash do que foi enviado
	if ((nchoice == 0)); then
		local h=""
		sh_wait_file "$chash" && h="$(<"$chash")"
		sh_verify_written "$REMOTE_DEV" remote "$lsize" "$h" || nchoice=1
	fi
	rm -f "$chash"
	local rinfo
	rinfo="$("${SSH_BASE[@]}" "$RSUDO fdisk -l $(printf '%q' "$REMOTE_DEV")" 2>&1)"
	unset SSHPASS
	sh_end_time_elapsed
	sh_log_result "$nchoice"

	if ((nchoice != 0)); then
		info "${cmsg_falha_clonagem}"
	else
		display_result "$REMOTE_HOST:$REMOTE_DEV" \
			"${BOLD}${GREEN}${REVERSE}${cmsg_clonagem_concluida}${RESET}\n\n" \
			"$(sh_time_summary)\n" \
			"${BOLD}${WHITE}$rinfo"
	fi
	sh_reset_conf
	return $nchoice
}

# Disco de um servidor SSH -> imagem neste computador
sh_remote_disk_to_image() {
	local -i nchoice
	local outfile base
	local kind="${1:-disk}" # disk | part
	local title="${cmsg_dir_rede_remoto_img}" lbl="${cmsg_disco_origem}"
	if [[ "$kind" == "part" ]]; then
		title="${cmsg_dir_rede_rpart_img}"
		lbl="${cmsg_part_origem}"
	fi

	sh_remote_pick_disk "$title" origem "$kind" || return 1

	image_format=$(sh_choose_image_format) || {
		unset SSHPASS
		return 1
	}

	base="${REMOTE_HOST#*@}_${REMOTE_DEV//\//_}"
	base="${base//__/_}"
	outfile="${PWD}/${base}"
	case "$image_format" in
	raw) outfile+=".img" ;;
	qcow2) outfile+=".qcow2" ;;
	zstd) outfile+=".img.zst" ;;
	xz) outfile+=".img.xz" ;;
	gzip) outfile+=".img.gz" ;;
	esac

	# nome do arquivo local
	while true; do
		outfile=$(${DIALOG} \
			--stdout \
			--backtitle "$ccabec" \
			--title "** ${cmsg_NOME_DA_IMAGEM} **" \
			--ok-label "${cmsg_Select}" \
			--cancel-label "${cmsg_button_voltar}" \
			--inputbox "$REMOTE_HOST:$REMOTE_DEV ($REMOTE_DESC)\n\n${cmsg_Entre_com_o_nome_da_imagem}:" \
			12 100 "$outfile") || {
			unset SSHPASS
			return 1
		}
		if [[ -z "$outfile" ]]; then
			conf "*** ${cmsg_NOME_DA_IMAGEM} ***" "\n${cmsg_Nome_da_imagem_invalido_Tente_novamente}\n" && continue
			unset SSHPASS
			return 1
		fi
		if [[ -e "$outfile" ]]; then
			conf "*** ${cmsg_NOME_DA_IMAGEM} ***" "${RED}$(printf "${cmsg_Imagem_s_ja_existe_Tentar_outro}" "$outfile")" && continue
			unset SSHPASS
			return 1
		fi
		# o caminho do disco remoto só vale aqui se o remoto for esta mesma máquina
		if ((SAME_MACHINE)); then
			sh_check_image_target "$REMOTE_DEV" "$outfile" "$REMOTE_SIZE" || continue
		else
			sh_check_image_target "" "$outfile" "$REMOTE_SIZE" || continue
		fi
		break
	done

	if ! conf "${cwarning}" \
		"${lbl}: ${GREEN}$REMOTE_HOST:$REMOTE_DEV | $REMOTE_DESC${RESET}\n\
${cmsg_imagem_destino} : ${RED}$outfile\n\n" \
		"${BOLD}${YELLOW}${cmsg_continuar_com_a_clonagem}?\n"; then
		unset SSHPASS
		return 1
	fi

	local -a compress=(cat) decomp=()
	local rcompress="" where="local"
	case "$image_format" in
	zstd) compress=(zstd --adapt=min=1,max=9 -T2 -c) decomp=(zstd -dc) rcompress="zstd --adapt=min=1,max=9 -T2 -c" ;;
	xz) compress=(xz -1 -c) decomp=(xz -dc) rcompress="xz -1 -T2 -c" ;;
	gzip) compress=(gzip -1 -c) decomp=(gzip -dc) rcompress="gzip -1 -c" ;;
	esac

	# comprime no remoto quando ele tiver a ferramenta: só o fluxo comprimido atravessa a rede.
	# Aqui o fluxo é descomprimido em paralelo só para o progresso e o hash do conteúdo
	# (isso também confirma que o arquivo recebido descomprime sem erro).
	if ((${#decomp[@]})) && "${SSH_BASE[@]}" "command -v ${rcompress%% *} >/dev/null" 2>/dev/null; then
		where="remoto"
	fi

	sh_start_time_elapsed
	local chash="/tmp/${_APP_}.chash.$$"
	rm -f "$chash"
	sh_log "origem=$REMOTE_HOST:$REMOTE_DEV ($REMOTE_DESC) | destino=$outfile | formato=$image_format (compressão: $where) | auth=$( ((SSH_USE_PASS)) && echo senha || echo chave)"
	(
		set -o pipefail
		if [[ "$where" == "remoto" ]]; then
			"${SSH_BASE[@]}" "$RSUDO cat -- $(printf '%q' "$REMOTE_DEV") | $rcompress" 2>>"${LOGFILE:-/dev/null}" |
				tee "$outfile" |
				"${decomp[@]}" 2>>"${LOGFILE:-/dev/null}" |
				tee >(sha256sum | cut -d' ' -f1 >"$chash") |
				pv -n -s "$REMOTE_SIZE" >/dev/null
		else
			"${SSH_BASE[@]}" "$RSUDO cat -- $(printf '%q' "$REMOTE_DEV")" 2>>"${LOGFILE:-/dev/null}" |
				pv -n -s "$REMOTE_SIZE" |
				tee >(sha256sum | cut -d' ' -f1 >"$chash") |
				"${compress[@]}" 2>>"${LOGFILE:-/dev/null}" >"$outfile"
		fi
	) 2>&1 |
		${DIALOG} \
			--title "${cmsg_running_disk_cloning^^}" \
			--colors \
			--gauge \
			"${BOLD}${WHITE}${REVERSE}${cmsg_running_disk_cloning} (ssh -> ${image_format} [${where}])${RESET}\n\n\
${lbl}: ${YELLOW}$REMOTE_HOST:$REMOTE_DEV | $REMOTE_DESC${RESET}\n\
${cmsg_imagem_destino} : ${RED}$outfile" \
			10 100 0
	nchoice=${PIPESTATUS[0]}
	if ((nchoice == 0)); then
		sh_meta_from_remote_dev "$REMOTE_DEV" # ainda com acesso ao remoto
	fi
	unset SSHPASS

	if ((nchoice == 0)) && [[ "$image_format" == "qcow2" ]]; then
		local tmp_raw="$outfile.tmp.raw"
		mv "$outfile" "$tmp_raw"
		${DIALOG} --title "${cmsg_running_disk_cloning^^}" --colors --infobox "\n${BOLD}${cmsg_Convertendo_para_QCOW2}${RESET}\n\n${cmsg_Aguarde_esta_operacao_pode_levar_alguns}" 8 70
		if qemu-img convert -O qcow2 "$tmp_raw" "$outfile" >/dev/null 2>&1; then
			rm -f "$tmp_raw"
		else
			nchoice=1
			sh_log "falha na conversão para qcow2, raw mantido em $tmp_raw"
			info "$(printf "${cmsg_falha_conversao_qcow2}" "$tmp_raw")"
		fi
	fi

	sh_end_time_elapsed
	sh_log_result "$nchoice"
	if ((nchoice != 0)); then
		if [[ -e "$outfile" ]]; then
			rm -f "$outfile"
			sh_log "arquivo incompleto removido: $outfile"
		fi
		info "${cmsg_falha_clonagem}"
		return $nchoice
	fi

	# ficha da imagem (.info) e hash do arquivo (.sha256)
	META_FORMAT="$image_format"
	META_CONTENT_BYTES="$REMOTE_SIZE"
	META_CONTENT_HASH=""
	sh_wait_file "$chash" && META_CONTENT_HASH="$(<"$chash")"
	rm -f "$chash"
	sh_write_image_meta "$outfile"

	SECTOR_SIZE="$REMOTE_SECTOR"
	display_result "$outfile" \
		"${BOLD}${GREEN}${REVERSE}${cmsg_clonagem_concluida}${RESET}\n\n" \
		"${BOLD}${GREEN}${REVERSE}${cmsg_Info_imagem} : $outfile${RESET}\n" \
		"${BOLD}${WHITE}\n$(sh_image_info "$outfile")\n\n" \
		"$(sh_time_summary)"
	return 0
}

# Disco de um servidor SSH -> disco deste computador (nunca o disco em uso pelo sistema)
sh_remote_disk_to_disk() {
	local -i nchoice
	local kind="${1:-disk}" # disk | part
	local title="${cmsg_dir_rede_remoto_disco}" lbl_src="${cmsg_disco_origem}" lbl_dst="${cmsg_disco_destino}"
	if [[ "$kind" == "part" ]]; then
		title="${cmsg_dir_rede_rpart_part}"
		lbl_src="${cmsg_part_origem}"
		lbl_dst="${cmsg_part_destino}"
	fi

	sh_remote_pick_disk "$title" origem "$kind" || return 1

	DEVICE_SOURCE="$REMOTE_HOST:$REMOTE_DEV"
	SIZE_SOURCE="$(numfmt --to=iec "$REMOTE_SIZE")"
	MODEL_SOURCE="${REMOTE_DESC#* | }"

	if [[ "$kind" == "part" ]]; then
		# escolhe a partição local (avisa se for menor; backup não se aplica a partição)
		part_source=""
		if ! sh_choose_target_partition; then
			unset SSHPASS
			return 1
		fi
		target="$part_target"
	else
		target=$(sh_list_disk "${cmsg_disco_destino}" "" destino)
	fi
	if [[ -z "$target" ]]; then
		unset SSHPASS
		return 1
	fi

	if sh_same_device "$REMOTE_DEV" "$target"; then
		alerta "${cwarning}" "\n${cmsg_disco_identico}\n\n$REMOTE_HOST:$REMOTE_DEV = $target"
		unset SSHPASS
		return 1
	fi

	if [[ "$kind" != "part" ]]; then
		sh_disk_info
		DEVICE_TARGET="$target"
		MODEL_TARGET="$(sh_splitarray "${AARRAY_DSK_DEVICES[$target]}" "$DSK_MODEL")"
		SIZE_TARGET="$(sh_splitarray "${AARRAY_DSK_DEVICES[$target]}" "$DSK_SIZE")"
	fi

	# partição já teve o aviso de tamanho no sh_choose_target_partition
	if [[ "$kind" != "part" ]] && ((REMOTE_SIZE > $(blockdev --getsize64 "$target"))); then
		conf "${YELLOW}${cwarning}" \
			"\n${BOLD}${RED}${REVERSE}${cmsg_O_disco_de_DESTINO_e_menor}${RESET}\n\n" \
			"${BOLD}${WHITE}${cmsg_disco_origem} : $DEVICE_SOURCE${SIZE_SOURCE:+ | $SIZE_SOURCE}${MODEL_SOURCE:+ | $MODEL_SOURCE}\n" \
			"${BOLD}${WHITE}${cmsg_disco_destino}: $DEVICE_TARGET${SIZE_TARGET:+ | $SIZE_TARGET}${MODEL_TARGET:+ | $MODEL_TARGET}${RESET}\n\n" \
			"${YELLOW}${cmsg_Prosseguir}" || {
			unset SSHPASS
			return 1
		}
	fi

	if ! conf "${cwarning}" \
		"\n${cmsg_todos_os_dados_serao_perdidos}\n\n""\
${BLUE} ${lbl_src}:  $DEVICE_SOURCE${SIZE_SOURCE:+ | $SIZE_SOURCE}${MODEL_SOURCE:+ | $MODEL_SOURCE} \n" \
		"${RED}${lbl_dst}: $DEVICE_TARGET${SIZE_TARGET:+ | $SIZE_TARGET}${MODEL_TARGET:+ | $MODEL_TARGET}\n\n" \
		"${BOLD}${WHITE}${cmsg_continuar_com_a_clonagem}?\n"; then
		unset SSHPASS
		return 1
	fi
	sh_backup_partitions "$target" "${target##*/}"
	if ! sh_check_target_free "$target"; then
		unset SSHPASS
		return 1
	fi

	sh_start_time_elapsed
	sh_log "origem=$DEVICE_SOURCE ($REMOTE_DESC) | destino=$target ($SIZE_TARGET $MODEL_TARGET) | auth=$( ((SSH_USE_PASS)) && echo senha || echo chave)"
	WRITE_SRC_CMD=("${SSH_BASE[@]}" "$RSUDO cat -- $(printf '%q' "$REMOTE_DEV")")
	WRITE_SRC_SIZE="$REMOTE_SIZE"
	sh_write_image_to_device "$REMOTE_DEV" "$target" "$DEVICE_SOURCE${SIZE_SOURCE:+ | $SIZE_SOURCE}${MODEL_SOURCE:+ | $MODEL_SOURCE}" "$DEVICE_TARGET${SIZE_TARGET:+ | $SIZE_TARGET}${MODEL_TARGET:+ | $MODEL_TARGET}"
	nchoice=$?
	unset WRITE_SRC_CMD WRITE_SRC_SIZE SSHPASS
	sh_end_time_elapsed
	sh_log_result "$nchoice"

	if ((nchoice != 0)); then
		info "${cmsg_falha_clonagem}"
	else
		display_result "fdisk -l $target" \
			"${BOLD}${GREEN}${REVERSE}${cmsg_clonagem_concluida}${RESET}\n\n" \
			"$(sh_time_summary)\n" \
			"${BOLD}${WHITE}$(fdisk -l "$target" 2>&1)"
		sh_ask_regen_uuids "$target"
	fi
	sh_reset_conf
	return $nchoice
}

# Restaura uma imagem que está num servidor SSH direto para um disco ou partição
sh_restore_network_ssh() {
	local -i nchoice
	local ssh_user="root" ssh_porta="22" rfile="/mnt/backup/" ssh_ip txt rsize kind local_ip
	local -a fields=()

	local_ip=$(sh_get_local_ip)
	ssh_ip="${local_ip%.*}.100"

	# 1. servidor e arquivo remoto
	while true; do
		exec 3>&1
		txt=$(${DIALOG} \
			--backtitle "$ccabec" \
			--title "** ${cmsg_dir_rede_restaura^^} **" \
			--ok-label "${cmsg_Select}" \
			--cancel-label "${cmsg_button_voltar}" \
			--colors \
			--mixedform "${cmsg_credenciais_restauracao}" \
			14 90 0 \
			"${cmsg_Usuario_Remoto}" 1 1 "$ssh_user" 1 20 20 0 0 \
			"${cmsg_IP_do_Servidor}" 2 1 "$ssh_ip" 2 20 30 0 0 \
			"${cmsg_Porta_SSH}" 3 1 "$ssh_porta" 3 20 10 0 0 \
			"${cmsg_Arquivo_Remoto}" 4 1 "$rfile" 4 20 60 0 0 \
			2>&1 1>&3)
		local st=$?
		exec 3>&-
		((st == 0)) || return 1

		mapfile -t fields <<<"$txt"
		ssh_user="${fields[0]}"
		ssh_ip="${fields[1]}"
		ssh_porta="${fields[2]}"
		rfile="${fields[3]}"

		if [[ -z "$ssh_user" || -z "$ssh_ip" || -z "$rfile" ]]; then
			conf "*** ${cmsg_CONFIGURACAO_SSH} ***" "\n${cmsg_Todos_os_campos_devem_ser_preenchidos}\n"
			continue
		fi
		# qcow2 precisa de acesso aleatório ao arquivo; não dá para ler em fluxo pela rede
		if [[ "${rfile,,}" == *.qcow2 ]]; then
			info "${cmsg_qcow2_rede_nao_suportado}"
			continue
		fi

		sh_ssh_login "$ssh_user" "$ssh_ip" "$ssh_porta" || continue
		sh_ssh_base "$ssh_user" "$ssh_ip" "$ssh_porta"
		REMOTE_HOST="$ssh_user@$ssh_ip"
		if ! sh_remote_check_tools "cat stat" "sha256sum zstd xz gzip"; then
			unset SSHPASS
			continue
		fi

		rsize=$("${SSH_BASE[@]}" "stat -c%s -- $(printf '%q' "$rfile")" 2>/dev/null)
		if ! [[ "$rsize" =~ ^[0-9]+$ ]]; then
			info "$(printf "${cmsg_arquivo_remoto_nao_encontrado}" "$ssh_user@$ssh_ip:$rfile")"
			unset SSHPASS
			continue
		fi
		break
	done

	DEVICE_SOURCE="$ssh_user@$ssh_ip:$rfile"
	MODEL_SOURCE=""
	SIZE_SOURCE=""
	# tamanho real: da ficha remota (.info); sem ficha, só é conhecido em imagem sem compressão
	local rbytes
	rbytes="$(sh_meta_get "$rfile" conteudo_bytes remote)"
	if ! [[ "$rbytes" =~ ^[0-9]+$ ]]; then
		rbytes=""
		case "${rfile,,}" in
		*.zst | *.xz | *.gz) : ;;
		*) rbytes="$rsize" ;;
		esac
	fi
	[[ -n "$rbytes" ]] && SIZE_SOURCE="$(numfmt --to=iec "$rbytes")"

	# 2. destino: disco inteiro ou partição
	kind=$(${DIALOG} \
		--stdout \
		--backtitle "$ccabec" \
		--title "${cmsg_Restaurar_em^^}" \
		--ok-label "${cmsg_Select}" \
		--cancel-label "${cmsg_button_voltar}" \
		--menu "${DEVICE_SOURCE}" \
		10 70 0 \
		disco "${cmsg_Disco_inteiro}" \
		part "${cmsg_Particao}") || {
		unset SSHPASS
		return 1
	}

	if [[ "$kind" == "disco" ]]; then
		target=$(sh_list_disk "${cmsg_disco_destino}" "" destino)
		[[ -z "$target" ]] && {
			unset SSHPASS
			return 1
		}
		sh_disk_info
		DEVICE_TARGET="$target"
		MODEL_TARGET="$(sh_splitarray "${AARRAY_DSK_DEVICES[$target]}" "$DSK_MODEL")"
		SIZE_TARGET="$(sh_splitarray "${AARRAY_DSK_DEVICES[$target]}" "$DSK_SIZE")"
		if [[ -n "$rbytes" ]] && ((rbytes > $(blockdev --getsize64 "$target"))); then
			conf "${cwarning}" "\n${RED}$(printf "${cmsg_imagem_maior_que_destino}" "$SIZE_SOURCE" "$SIZE_TARGET")${RESET}\n" || {
				unset SSHPASS
				return 1
			}
		fi
	else
		part_source=""
		sh_choose_target_partition || {
			unset SSHPASS
			return 1
		}
		target="$part_target"
		if [[ -n "$rbytes" ]] && ((rbytes > $(blockdev --getsize64 "$target"))); then
			conf "${cwarning}" "\n${RED}$(printf "${cmsg_imagem_maior_que_destino}" "$SIZE_SOURCE" "$SIZE_TARGET")${RESET}\n" || {
				unset SSHPASS
				return 1
			}
		fi
	fi

	# 3. confirmação, backup da tabela e desmontagem
	if ! conf "${cwarning}" \
		"\n${cmsg_todos_os_dados_serao_perdidos}\n\n""\
${BLUE} ${cmsg_imagem_origem}:  $DEVICE_SOURCE \n" \
		"${RED}$(sh_label_destino "$target"): $DEVICE_TARGET${SIZE_TARGET:+ | $SIZE_TARGET}${MODEL_TARGET:+ | $MODEL_TARGET}\n\n" \
		"${BOLD}${WHITE}${cmsg_continuar_com_a_clonagem}?\n"; then
		unset SSHPASS
		return 1
	fi
	if ! sh_ask_verify_image "$rfile" remote; then
		unset SSHPASS
		return 1
	fi
	sh_backup_partitions "$target" "${target##*/}"
	if ! sh_check_target_free "$target"; then
		unset SSHPASS
		return 1
	fi

	# 4. gravação: ssh cat -> pv -> descompressor -> dd
	sh_start_time_elapsed
	sh_log "origem=$DEVICE_SOURCE ($(numfmt --to=iec "$rsize")) | destino=$target ($SIZE_TARGET $MODEL_TARGET) | auth=$( ((SSH_USE_PASS)) && echo senha || echo chave)"
	WRITE_SRC_CMD=("${SSH_BASE[@]}" "cat -- $(printf '%q' "$rfile")")
	WRITE_SRC_SIZE="$rsize"
	sh_write_image_to_device "$rfile" "$target" "$DEVICE_SOURCE" "$DEVICE_TARGET${SIZE_TARGET:+ | $SIZE_TARGET}${MODEL_TARGET:+ | $MODEL_TARGET}"
	nchoice=$?
	unset WRITE_SRC_CMD WRITE_SRC_SIZE SSHPASS
	sh_end_time_elapsed
	sh_log_result "$nchoice"

	if ((nchoice != 0)); then
		info "${cmsg_falha_clonagem}"
	else
		display_result "fdisk -l $target" \
			"${BOLD}${GREEN}${REVERSE}${cmsg_clonagem_concluida}${RESET}\n\n" \
			"$(sh_time_summary)\n" \
			"${BOLD}${WHITE}$(fdisk -l "$target" 2>&1)"
		sh_ask_regen_uuids "$target"
	fi
	sh_reset_conf
	return $nchoice
}

# Idiomas disponíveis: pt_BR (textos originais) + os que têm .mo instalado
sh_available_languages() {
	local mo
	echo "pt_BR"
	for mo in "$TEXTDOMAINDIR"/*/LC_MESSAGES/"$TEXTDOMAIN".mo; do
		[[ -e "$mo" ]] || continue
		mo="${mo#"$TEXTDOMAINDIR"/}"
		[[ "${mo%%/*}" != "pt_BR" ]] && echo "${mo%%/*}"
	done
}

# Troca o idioma da interface em tempo de execução
sh_choose_language() {
	local lang
	local -a items=()

	while read -r lang; do
		items+=("$lang")
	done < <(sh_available_languages)

	lang=$(${DIALOG} \
		--stdout \
		--backtitle "$ccabec" \
		--title "${cmsg_Idioma^^}" \
		--ok-label "${cmsg_Select}" \
		--cancel-label "${cmsg_button_voltar}" \
		--default-item "${LANGUAGE%%:*}" \
		--no-items \
		--menu "${cmsg_Escolha_o_idioma}" \
		0 50 0 "${items[@]}") || return 1

	export LANGUAGE="$lang"
	sh_Language # recarrega todas as mensagens no novo idioma
	sh_log "idioma alterado para $lang"
}

# Executa uma operação registrando início e fim no log
sh_run_op() {
	local name="$1"
	local -i st
	shift

	LOG_OP="$name"
	sh_log "=== início da operação ==="
	"$@"
	st=$?
	sh_log "=== fim da operação (status=$st) ==="
	LOG_OP=""
	return $st
}

sh_list_disks_menu() {
	sh_list_disk "${cmsg_Listar_Discos^^}" "" lista >/dev/null
}

# Submenu de um grupo; ao terminar uma operação, volta ao mesmo submenu
sh_submenu() {
	local group="$1"
	local title choice="" width pad i
	local -a items=() pairs=()

	while true; do
		width=80
		# montado a cada volta: se o idioma mudar, os textos já vêm traduzidos
		case "$group" in
		clonar)
			title="${cmsg_Grupo_Clonar}"
			pairs=("${cmsg_dir_disco_disco}" "${cmsg_desc_disco_disco}"
				"${cmsg_dir_part_part}" "${cmsg_desc_part_part}")
			;;
		criar)
			title="${cmsg_Grupo_Criar_imagem}"
			pairs=("${cmsg_dir_disco_img}" "${cmsg_desc_disco_img}"
				"${cmsg_dir_part_img}" "${cmsg_desc_part_img}")
			;;
		restaurar)
			title="${cmsg_Grupo_Restaurar_imagem}"
			pairs=("${cmsg_dir_img_disco}" "${cmsg_desc_img_disco}"
				"${cmsg_dir_img_part}" "${cmsg_desc_img_part}"
				"${cmsg_dir_iso}" "${cmsg_desc_iso}")
			;;
		rede)
			title="${cmsg_Grupo_Rede}"
			width=100
			pairs=("${cmsg_dir_rede_envia}" "${cmsg_desc_rede_envia}"
				"${cmsg_dir_rede_lpart_img}" "${cmsg_desc_rede_lpart_img}"
				"${cmsg_dir_rede_disco_disco}" "${cmsg_desc_rede_disco_disco}"
				"${cmsg_dir_rede_lpart_rpart}" "${cmsg_desc_rede_lpart_rpart}"
				"${cmsg_dir_rede_restaura}" "${cmsg_desc_rede_restaura}"
				"${cmsg_dir_rede_remoto_img}" "${cmsg_desc_rede_remoto_img}"
				"${cmsg_dir_rede_rpart_img}" "${cmsg_desc_rede_rpart_img}"
				"${cmsg_dir_rede_remoto_disco}" "${cmsg_desc_rede_remoto_disco}"
				"${cmsg_dir_rede_rpart_part}" "${cmsg_desc_rede_rpart_part}")
			;;
		*) return 1 ;;
		esac

		# "origem -> destino : descrição", com o ":" alinhado (sh_pad conta caracteres)
		pad=0
		for ((i = 0; i < ${#pairs[@]}; i += 2)); do
			((${#pairs[i]} > pad)) && pad=${#pairs[i]}
		done
		items=()
		for ((i = 0; i < ${#pairs[@]}; i += 2)); do
			items+=($((i / 2 + 1)) "$(sh_pad "${pairs[i]}" "$pad") : ${pairs[i + 1]}")
		done

		choice=$(
			${DIALOG} \
				--clear \
				--stdout \
				--backtitle "$ccabec" \
				--colors \
				--title "${cmsg_MENU_PRINCIPAL} > ${title^^}" \
				--ok-label "${cmsg_Select}" \
				--cancel-label "${cmsg_button_voltar}" \
				--default-item "$choice" \
				--menu "${cmsg_LABEL}\n\n${cmsg_Escolha_a_operacao}:" \
				$((${#items[@]} / 2 + 10)) "$width" $((${#items[@]} / 2)) \
				"${items[@]}"
		) || return 0

		case "$group:$choice" in
		clonar:1) sh_run_op "Disco -> Disco" sh_clone_disk_to_disk ;;
		clonar:2) sh_run_op "Partição -> Partição" sh_clone_part_to_part ;;
		criar:1) sh_run_op "Disco -> Imagem" sh_clone_disk_to_image ;;
		criar:2) sh_run_op "Partição -> Imagem" sh_clone_part_to_image ;;
		restaurar:1) sh_run_op "Imagem -> Disco" sh_clone_image_to_disk ;;
		restaurar:2) sh_run_op "Imagem -> Partição" sh_clone_image_to_part ;;
		restaurar:3) sh_run_op "ISO -> Pendrive/Disco" sh_execute_iso2usb ;;
		rede:1) sh_run_op "Disco local -> Imagem remota" sh_clone_network_ssh disk ;;
		rede:2) sh_run_op "Partição local -> Imagem remota" sh_clone_network_ssh part ;;
		rede:3) sh_run_op "Disco local -> Disco remoto" sh_local_disk_to_remote_disk disk ;;
		rede:4) sh_run_op "Partição local -> Partição remota" sh_local_disk_to_remote_disk part ;;
		rede:5) sh_run_op "Imagem remota -> Disco/Partição local" sh_restore_network_ssh ;;
		rede:6) sh_run_op "Disco remoto -> Imagem local" sh_remote_disk_to_image disk ;;
		rede:7) sh_run_op "Partição remota -> Imagem local" sh_remote_disk_to_image part ;;
		rede:8) sh_run_op "Disco remoto -> Disco local" sh_remote_disk_to_disk disk ;;
		rede:9) sh_run_op "Partição remota -> Partição local" sh_remote_disk_to_disk part ;;
		esac
	done
}

# --keep-tite \
sh_choose_clone_type() {
	local choice=""
	local -a groups=("" clonar criar restaurar rede)

	while true; do
		choice=$(
			${DIALOG} \
				--clear \
				--stdout \
				--backtitle "$ccabec" \
				--colors \
				--title "${cmsg_MENU_PRINCIPAL}" \
				--ok-label "${cmsg_Select}" \
				--cancel-label "${cmsg_Sair}" \
				--default-item "$choice" \
				--menu "${cmsg_LABEL}\n\n${cmsg_Escolha_o_tipo_de_clone}:" \
				17 80 7 \
				1 "${cmsg_Grupo_Clonar}" \
				2 "${cmsg_Grupo_Criar_imagem}" \
				3 "${cmsg_Grupo_Restaurar_imagem}" \
				4 "${cmsg_Grupo_Rede}" \
				5 "${cmsg_Listar_Discos}" \
				6 "${cmsg_Tema}" \
				7 "${cmsg_Idioma}"
		)

		exit_status=$?
		case $exit_status in
		"$D_ESC" | "$D_CANCEL")
			exit 0
			;;
		esac
		case "$choice" in
		5) sh_run_op "Listar Discos" sh_list_disks_menu ;;
		6) sh_run_op "Seletor de temas" sh_run_binary 'chili-dialog-theme-selector' ;;
		7) sh_run_op "Idioma da interface" sh_choose_language ;;
		*) sh_submenu "${groups[choice]}" ;;
		esac
	done
}

sh_configure
sh_Language
sh_display
sh_checkroot "$@"
sh_log_init
sh_checkDependencies "${DEPENDENCIES[*]}"
sh_choose_clone_type

#########################################################################
# ChangeLog
#########################################################################
#
# 2026-09-24 (v6.9.24.20260924)
#
# Segurança de dados
#  - Ferramentas do computador remoto conferidas logo após o login, conforme
#    a operação: falta obrigatória (ex.: lsblk, dd) mostra o que instalar e
#    não começa; falta opcional segue e fica registrada no log.
#  - Verificação de "em uso" falha fechada: se não puder rodar (ferramenta
#    ausente, SSH caiu), destino é bloqueado e origem gera aviso.
#  - Espaço livre e tipo do sistema de arquivos no remoto via "df -P" e
#    /proc/mounts (funciona em BusyBox, que não tem "df --output").
#  - Root no remoto identificado pelo uid (id -u), não pelo nome do usuário.
#  - Ferramentas ausentes no remoto: tela com obrigatórias e opcionais (e o
#    que cada opcional deixa de fazer), pacote de cada uma, comando de
#    instalação conforme a distro remota (Void, Arch, Debian, Fedora, Alpine,
#    openSUSE) e manifesto salvo em /tmp/chili-clonedisk-remoto-<ip>-<data>.txt.
#
# Interface
#  - Lista de partições remotas mostrava "?" em partições sem sistema de
#    arquivos (BIOS boot, Microsoft reserved, estendida...). Agora mostra
#    "none" e o tipo da partição, ex.: "(BIOS boot)", vindo do PARTTYPENAME do lsblk
#    ou, sem udev/util-linux antigo, do blkid -p (código GPT/MBR traduzido).
#  - Detecção do sistema de arquivos remoto com "blkid -p" (lê direto do
#    dispositivo, sem cache) e, se não achar nada, o blkid normal.
#  - lsblk remoto sem a coluna PARTTYPENAME (util-linux antigo) não deixa a
#    lista vazia: repete a consulta sem ela.
#
# 2026-09-23 (v6.9.23.20260923)
#
# Internacionalização (gettext)
#  - Todas as mensagens visíveis passam por gettext e ficam como variáveis
#    cmsg_* em sh_Language(); nenhuma chamada gettext solta nas funções.
#  - Removidos os ${cmsg_x[LC_DEFAULT]} (mensagens saíam vazias fora do pt_BR).
#  - Removidos Alanguage, Alocale, LC_DEFAULT, sh_getLocale e flags de idioma.
#  - Maiúsculas via expansão ${var^^}, sem variáveis duplicadas.
#  - Fallback: sem o binário gettext, mostra o texto original (pt_BR).
#  - Troca de idioma pelo menu, a partir dos .mo instalados (sem lista fixa).
#  - sh_pad: alinhamento por caracteres (funciona com acentos e traduções).
#  - Textos corrigidos: "Formatando partição" durante a clonagem, rótulos de
#    disco/partição/imagem nas telas de partição e imagem, títulos "Info
#    disco"/"Info imagem", menu de formato com "Voltar" em vez de "Sair".
#
# Interface
#  - Menu principal reorganizado: Clonar (local), Criar imagem, Restaurar
#    imagem, Rede (SSH), Listar Discos, Seletor de temas, Idioma.
#  - Submenus no padrão "origem -> destino : descrição" com textos genéricos
#    (disco/partição/imagem, local/remoto).
#  - Altura dos menus corrigida (todas as opções visíveis).
#  - Cabeçalho da lista de discos conforme o modo (origem, destino, lista).
#  - Erros de nome/local da imagem voltam ao formulário, sem cair no menu.
#  - Nome padrão da imagem sem "_none" e sem "_" inicial (local e remoto).
#  - Tamanho real da imagem nas telas (qcow2 virtual, xz/zst descomprimido).
#  - Somente -h/--help e -V/--version; o resto é via dialog, sem elevar
#    privilégios para ajuda e versão.
#  - Modo texto removido (tudo como grafico=true); has_command() no lugar de
#    command -v; bloco # debug/PS4 movido para o topo.
#
# Correções
#  - Imagem -> Partição e Partição -> Imagem usavam variáveis erradas.
#  - Partição -> Imagem ignorava a compressão escolhida.
#  - Imagem qcow2 era gravada crua no disco (agora qemu-img convert).
#  - Backup da tabela de partições nunca era feito (sh_diahora/log_exec).
#  - Nome de imagem vazio respondido com "Não" encerrava o script.
#  - Funções inexistentes chamadas (log_info_msg, evaluate_retval) e
#    variáveis indefinidas em sh_run_binary.
#  - NAME_SOURCE preenchido como NAME_TARGET em sh_choose_source_disk.
#  - Resultado final usava fdisk até em imagem comprimida/qcow2
#    (sh_image_info mostra a informação certa por formato).
#  - Status das operações: cancelamentos e falhas registrados corretamente;
#    compressor e ssh verificados (pipefail).
#  - sh_checkdisk: desmontagem não se perdia mais em subshell; swapoff.
#  - Recursão sem return na escolha de destino; recusar desmontar voltava a
#    encerrar o script (die) — agora volta ao menu.
#  - Desmontagem do destino só depois da confirmação.
#  - Gravação em dispositivo com dd bs=4M iflag=fullblock conv=fsync + sync;
#    o gauge mostrava um comando dd diferente do executado.
#  - sudo desnecessário em blockdev (script já roda como root).
#  - pacman --needed, distros sem suporte não fingem sucesso, instala só os
#    pacotes que faltam.
#  - Novas dependências verificadas: fdisk, sfdisk, blockdev, lsblk, numfmt,
#    stdbuf, gettext e findmnt; qemu-img exigido ao escolher qcow2.
#  - Instalação de dependências funciona mesmo sem o dialog instalado.
#  - Tabela de partições relida após gravar disco inteiro (partx/udevadm).
#  - Arquivo incompleto apagado em caso de falha (local e remoto).
#  - Senha SSH via SSHPASS (sshpass -e), sem eval nem senha no ps.
#  - Elevação por su com argumentos protegidos.
#  - Dispositivos repetidos em /dev/mapper (LVM thin) e volumes internos do
#    LVM removidos das listas; zram/ram e dispositivos de 0 bytes também.
#  - Funções e variáveis mortas removidas.
#  - Linhas DEBUG do formulário de imagem vão para o log, não para a tela.
#  - Copyright do -V atualizado para 2019-2026.
#  - Seta "→" trocada por "->" em todos os textos (colava na palavra seguinte
#    em fontes que a desenham com largura dupla).
#  - Aviso de origem igual ao destino vale para disco e partição.
#  - Disco/Partição remota -> Imagem local: rótulo da origem aparecia vazio
#    na confirmação e no progresso.
#  - Telas não mostram mais "| |" quando tamanho ou modelo são desconhecidos;
#    imagem não repete "IMAGEM ORIGEM" no lugar do modelo.
#  - Tamanho real da imagem lido da ficha (.info) quando o formato não o
#    guarda (zstd gerado em fluxo, gzip); vale também para o aviso de imagem
#    maior que o destino (inclusive na restauração remota, agora também
#    quando o destino é uma partição).
#
# Segurança de dados
#  - sh_disk_busy: detecta uso de disco/partição local e remoto — montagens
#    (mountinfo, inclusive bind/btrfs), swap, LVM/LUKS/RAID (holders),
#    processo com o dispositivo aberto (fuser) e pool ZFS.
#  - Destino em uso é bloqueado (local e remoto); origem em uso gera aviso.
#  - Disco do sistema nunca aparece como destino.
#  - Detecta quando o "remoto" é a mesma máquina (boot_id) e impede origem e
#    destino iguais.
#  - Imagem: bloqueia gravar dentro do próprio disco de origem, diretório sem
#    escrita, FAT32 com imagem > 4 GiB e falta de espaço (raw/qcow2); avisa
#    em imagem comprimida.
#  - Aviso de imagem maior que o destino; destino menor que a origem.
#  - Arquivo remoto existente: pergunta antes de sobrescrever.
#  - Novos UUIDs opcionais após clonar (disk-id, PARTUUID, ext2/3/4, xfs,
#    btrfs, vfat, ntfs, swap e LVM via vgimportclone), padrão "Não".
#
# Novas operações
#  - Formatos de imagem: raw, qcow2, zstd, xz e gzip; restauração de imagens
#    comprimidas.
#  - Imagem remota -> Disco/Partição local (ssh, sem cópia intermediária).
#  - Disco remoto -> Imagem local.
#  - Disco remoto -> Disco local.
#  - Disco local -> Disco remoto.
#  - Partição remota -> Imagem local.
#  - Partição remota -> Partição local.
#  - Partição local -> Imagem remota.
#  - Partição local -> Partição remota.
#  - Remoto -> Imagem local: com zstd/xz/gzip, comprime no computador remoto
#    (quando ele tiver a ferramenta) e só o fluxo comprimido passa pela rede;
#    aqui é descomprimido em paralelo para progresso, hash e validação.
#
# Integridade
#  - Toda imagem criada (local ou remota) ganha <imagem>.sha256 (formato do
#    "sha256sum -c") e <imagem>.info (ficha: origem, host, modelo, serial,
#    tamanhos, formato, data, hash do conteúdo, hash do arquivo e tabela de
#    partições da origem). O hash do conteúdo é calculado durante a cópia.
#  - "Info imagem" mostra a ficha.
#  - Antes de restaurar (local ou remoto), opcional: confere o sha256 do
#    arquivo; sem hash, usa o checksum embutido (zstd/xz/gzip) ou a
#    estrutura (qcow2) e informa o nível da verificação; raw sem hash avisa
#    que não há verificação e oferece gerar o .sha256 a partir de agora.
#  - Imagem corrompida ou alterada é bloqueada.
#  - Depois de gravar em disco/partição (local ou remoto), opcional: relê o
#    destino (sem cache) e compara com o hash do que foi enviado; em imagem
#    com ficha, compara também com o conteúdo original.
#
# Log
#  - Log por execução em /tmp/chili-clonedisk-AAAAMMDD-HHMM.log, com a
#    operação do menu em cada linha, origem, destino, resultado e tempo.
#  - Registra também desmontagens, backups de tabela, bloqueios por disco em
#    uso, novos UUIDs, falhas e erros do compressor.
#
